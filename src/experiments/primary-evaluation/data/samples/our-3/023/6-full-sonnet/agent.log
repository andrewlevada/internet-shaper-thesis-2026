    color: #111;
    cursor: pointer;
    outline: none;
    min-width: 180px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.10);
    transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    line-height: 1.3;
  }

  #pws-sort-select:hover {
    border-color: #e60023;
    box-shadow: 0 3px 12px rgba(230,0,35,0.18);
  }

  #pws-sort-select:focus {
    border-color: #e60023;
    box-shadow: 0 0 0 3px rgba(230,0,35,0.22);
    background: #fff8f8;
  }

  #pws-sort-select option {
    font-weight: 500;
    background: #fff;
    color: #111;
  }

  /* Active badge shown when non-default option selected */
  #pws-sort-active-badge {
