wrapper.id = 'pws-sort-dropdown-wrapper';

const label = document.createElement('label');
label.setAttribute('for', 'pws-sort-select');
label.textContent = 'Sort by:';

const selectWrapper = document.createElement('div');
selectWrapper.id = 'pws-sort-select-wrapper';

const select = document.createElement('select');
select.id = 'pws-sort-select';
select.setAttribute('aria-label', 'Sort search results');

const options = [
  { value: 'relevance',  label: '✦  Relevance'   },
  { value: 'newest',     label: '🕐  Newest'       },
  { value: 'most_saved', label: '❤️  Most Saved'   },
  { value: 'trending',   label: '🔥  Trending'     },
  { value: 'popular',    label: '⭐  Most Popular' },
];

options.forEach(({ value, label: text }) => {
