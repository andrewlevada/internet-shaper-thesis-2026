    { label: 'Speakers',            vals: ['4× AKG tuned', '4× AKG tuned', '2× stereo'] },
    { label: 'Dolby Atmos',         vals: ['✓', '✓', '✗'] },
    { label: 'Microphones',         vals: ['4× noise cancelling', '4× noise cancelling', '2×'] },
  ]},
];

// ── Build table ─────────────────────────────────────────────────────────────
const scrollWrap = document.createElement('div');
scrollWrap.style.cssText = 'overflow-x:auto;';

const table = document.createElement('table');
table.style.cssText = `
  width:100%; border-collapse:collapse;
  font-size:13px; min-width:520px;
`;

// thead
const thead = document.createElement('thead');
const headRow = document.createElement('tr');

const thSpec = document.createElement('th');
thSpec.textContent = 'Specification';
thSpec.style.cssText = `
  background:#f5f7ff; color:#1428A0; font-weight:700;
  padding:10px 14px; text-align:left; border-bottom:2px solid #1428A0;
  position:sticky; left:0; z-index:2; white-space:nowrap;
  width:160px; font-size:12px;
`;
headRow.appendChild(thSpec);

cols.forEach(col => {
  const th = document.createElement('th');
  th.style.cssText = 'background:#f5f7ff; padding:10px 12px; text-align:center; border-bottom:2px solid #1428A0; border-left:1px solid #dde4ff; min-width:170px;';

  const badge = document.createElement('span');
  badge.textContent = col.badge;
  badge.style.cssText = `display:inline-block;background:${col.badgeColor};color:#fff;font-size:9px;font-weight:700;border-radius:3px;padding:1px 5px;margin-bottom:4px;letter-spacing:.5px;`;

  const nameEl = document.createElement('div');
  nameEl.textContent = col.name;
  nameEl.style.cssText = 'font-size:13px;font-weight:700;color:#1428A0;line-height:1.3;';

  const priceWrap = document.createElement('div');
  priceWrap.style.cssText = 'margin-top:4px;';

  const priceEl = document.createElement('span');
  priceEl.textContent = col.price;
  priceEl.style.cssText = 'font-size:15px;font-weight:800;color:#1428A0;';

  const origEl = document.createElement('span');
  origEl.textContent = ' ' + col.origPrice;
  origEl.style.cssText = 'font-size:11px;color:#999;text-decoration:line-through;margin-left:4px;';

  const stockEl = document.createElement('div');
  stockEl.textContent = col.stock;
  stockEl.style.cssText = `font-size:10px;color:${col.stockColor};font-weight:600;margin-top:2px;`;

  priceWrap.appendChild(priceEl);
  priceWrap.appendChild(origEl);

  th.appendChild(badge);
  th.appendChild(nameEl);
  th.appendChild(priceWrap);
  th.appendChild(stockEl);
  headRow.appendChild(th);
});

thead.appendChild(headRow);
table.appendChild(thead);

// tbody
const tbody = document.createElement('tbody');
let globalRowIdx = 0;

specs.forEach(section => {
  // Category row
  const catRow = document.createElement('tr');
  const catTd = document.createElement('td');
  catTd.setAttribute('colspan', '4');
  catTd.textContent = section.category;
  catTd.style.cssText = 'background:#1428A0;color:#fff;font-size:11px;font-weight:700;padding:6px 14px;letter-spacing:.8px;text-transform:uppercase;';
  catRow.appendChild(catTd);
  tbody.appendChild(catRow);

  section.rows.forEach(row => {
    const tr = document.createElement('tr');
    const isEven = (globalRowIdx % 2 === 0);
    tr.style.background = isEven ? '#ffffff' : '#f8f9ff';
    globalRowIdx++;

    const tdLabel = document.createElement('td');
    tdLabel.textContent = row.label;
    tdLabel.style.cssText = `
      padding:8px 14px; font-weight:600; color:#444; white-space:nowrap;
      border-right:1px solid #dde4ff; position:sticky; left:0; z-index:1;
      background:inherit; font-size:12px;
    `;
    tr.appendChild(tdLabel);

    row.vals.forEach((val, i) => {
      const td = document.createElement('td');
      td.style.cssText = 'padding:8px 12px; text-align:center; border-left:1px solid #dde4ff; color:#222; line-height:1.4; font-size:12px;';

      // Highlight best-in-class value (first column = highest tier)
      if (i === 0) {
        td.style.fontWeight = '600';
        td.style.color = '#1428A0';
      }
      // Checkmarks & cross marks
      if (val === '✓' || val.startsWith('✓')) {
        td.style.color = '#2e7d32';
        td.style.fontWeight = '700';
      } else if (val === '✗') {
        td.style.color = '#aaa';
      }

      // Benchmark bars for TOPS and Cinebench
      const benchLabels = ['cinebench', 'tops', 'tops'];
      const isBenchmark = row.label.toLowerCase().includes('cinebench') || row.label.toLowerCase().includes('ai performance');
      if (isBenchmark) {
        const numMatch = val.match(/[\d.]+/);
        const numVal = numMatch ? parseFloat(numMatch[0]) : 0;
        const maxMap = { 'Cinebench R24 (MT)': 1000, 'AI Performance': 50 };
        const maxVal = maxMap[row.label] || 100;
        const pct = Math.min((numVal / maxVal) * 100, 100);

        const barWrap = document.createElement('div');
        barWrap.style.cssText = 'margin-top:4px; background:#e8eaf6; border-radius:4px; height:6px; overflow:hidden;';
        const bar = document.createElement('div');
        bar.style.cssText = `width:${pct}%;height:100%;border-radius:4px;background:${i===0?'#1428A0':i===1?'#2853c8':'#90a4e0'};transition:width .4s ease;`;
        barWrap.appendChild(bar);

        const numSpan = document.createElement('div');
        numSpan.textContent = val;
        numSpan.style.cssText = 'font-size:12px;font-weight:600;';

        td.style.fontWeight = '';
        td.appendChild(numSpan);
        td.appendChild(barWrap);
      } else {
        td.textContent = val;
      }

      tr.appendChild(td);
    });

    tbody.appendChild(tr);
  });
});

table.appendChild(tbody);
scrollWrap.appendChild(table);

// Footnote
const footnote = document.createElement('p');
footnote.textContent = '* Specs based on Samsung NL product listings. Benchmark scores are representative estimates. Prices shown are promotional sale prices (incl. BTW).';
footnote.style.cssText = 'font-size:10px;color:#888;margin:0;padding:10px 16px 12px;border-top:1px solid #e8eaf6;background:#fafbff;';

body.appendChild(scrollWrap);
body.appendChild(footnote);

// ── Toggle ──────────────────────────────────────────────────────────────────
header.addEventListener('click', () => {
  const isOpen = body.style.display !== 'none';
  body.style.display = isOpen ? 'none' : 'block';
  chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
  header.setAttribute('aria-expanded', String(!isOpen));
});

panel.appendChild(header);
panel.appendChild(body);

element.appendChild(panel);


