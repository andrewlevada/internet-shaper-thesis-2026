{
  "rules": [
    {
      "label": "Hide top banner ad",
      "query_selector": ".regionTopAds, section[aria-label=\"Advertisement\"]",
      "logic": "element.style.display = 'none'"
    },
    {
      "label": "Hide Taboola sponsored grid",
      "query_selector": "#taboola-below-content-thumbnails-article, .tbl-feed-container, [data-module-key=\"main-block-1\"]",
      "logic": "element.style.display = 'none'"
    },
    {
      "label": "Hide sidebar ad slot",
      "query_selector": "[data-region=\"sidebar\"]",
      "logic": "element.style.display = 'none'"
    },
    {
      "label": "Force single-column layout",
      "query_selector": "[data-layout=\"responsive-sidebar\"]",
      "logic": "element.style.gridTemplateColumns = '1fr';\nelement.style.gridTemplateAreas = '\"contentTop\" \"main\" \"contentBottom\"';"
    }
  ],
  "result": {
    "success": true,
    "log": "rules applied in real-time"
  }
}
