{
  "label": "Show pin descriptions below cards",
  "query_selector": "[data-test-id=\"pin\"]",
  "logic": "// Avoid running multiple times on same element\nif (element.querySelector('.pin-info-overlay')) return;\n\n// Get description from aria-label of the first deeplink anchor or image alt\nvar description = '';\nvar links = element.querySelectorAll('a[aria-label]');\nif (links.length > 0) {\n  description = links[0].getAttribute('aria-label') || '';\n}\nif (!description) {\n  var img = element.querySelector('img[alt]');\n  if (img) description = img.getAttribute('alt') || '';\n}\nif (!description) return;\n\n// Create container for the info text\nvar infoContainer = document.createElement('div');\ninfoContainer.className = 'pin-info-overlay';\ninfoContainer.style.cssText = 'padding: 8px; background: rgba(255,255,255,0.95); border-radius: 0 0 16px 16px; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;';\n\n// Create description text\nvar descEl = document.createElement('div');\ndescEl.style.cssText = 'font-size: 12px; color: #333; line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;';\ndescEl.textContent = description;\ninfoContainer.appendChild(descEl);\n\n// Insert after the image wrapper section (after first child div of pin)\nvar firstChild = element.firstElementChild;\nif (firstChild) {\n  // Find the contentLayer and insert after its parent\n  var contentLayer = element.querySelector('[data-test-id=\"contentLayer\"]');\n  if (contentLayer) {\n    var contentLayerParent = contentLayer.closest('.ADXRXN');\n    if (contentLayerParent && contentLayerParent.parentElement) {\n      contentLayerParent.parentElement.parentNode.insertBefore(infoContainer, contentLayerParent.parentElement.nextSibling);\n    } else {\n      firstChild.appendChild(infoContainer);\n    }\n  } else {\n    firstChild.appendChild(infoContainer);\n  }\n}"
}

