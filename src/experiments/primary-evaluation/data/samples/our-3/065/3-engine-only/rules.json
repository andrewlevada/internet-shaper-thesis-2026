<a class=\"resource-card\" href=\"https://medium.com/\" target=\"_blank\">' +\n      '<div class=\"resource-icon\" style=\"background:#000;\">M</div>' +\n      '<div class=\"resource-info\"><span class=\"resource-name\">Medium</span><span class=\"resource-desc\">Reading & writing platform</span></div>' +\n    '</a>' +\n    '<a class=\"resource-card\" href=\"https://www.linkedin.com/\" target=\"_blank\">' +\n      '<div class=\"resource-icon\" style=\"background:#0a66c2;\">in</div>' +\n      '<div class=\"resource-info\"><span class=\"resource-name\">LinkedIn</span><span class=\"resource-desc\">Professional network</span></div>' +\n    '</a>' +\n  '</div>';\n\nelement.parentNode.insertBefore(container, element);"
