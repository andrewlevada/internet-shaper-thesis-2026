const radarLink = document.querySelector('a[href*="/weather/radar/interactive/l/"]');
if (!forecastLink || !radarLink) return;

const forecastHref = forecastLink.getAttribute('href');
const radarHref = radarLink.getAttribute('href');

// Extract location code from URL
const locMatch = forecastHref.match(/\/l\/([a-f0-9]+)/);
const locCode = locMatch ? locMatch[1] : '';

// Build the hourly/10-day/monthly links
const hourlyHref = forecastHref.replace('/today/', '/hourbyhour/');
const tenDayHref = forecastHref.replace('/today/', '/tenday/');
const weekendHref = forecastHref.replace('/today/', '/weekend/');

// Build panel HTML
const panel = document.createElement('div');
panel.id = 'wx-utility-panel';
panel.style.cssText = `
  background: linear-gradient(135deg, #0a1f5c 0%, #1a3a8f 50%, #0d2d6b 100%);
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 20px;
  font-family: inherit;
  box-shadow: 0 4px 24px rgba(10,31,92,0.18);
  color: white;
`;

panel.innerHTML = `
  <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
    <span style="font-size:16px;font-weight:700;letter-spacing:0.02em;color:#e0eaff;">Weather Utility Quick Access</span>
    <span style="margin-left:auto;font-size:11px;color:#93c5fd;opacity:0.8;">Your location forecast</span>
  </div>

  <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:10px; margin-bottom:16px;">

    <a href="${forecastHref}" style="
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18);
      border-radius:12px; padding:14px 10px; text-decoration:none; color:white;
      transition:background 0.2s; gap:6px;
      " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.10)'">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <span style="font-size:13px;font-weight:600;">Current</span>
      <span style="font-size:11px;opacity:0.75;">Conditions</span>
    </a>

    <a href="${hourlyHref}" style="
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18);
      border-radius:12px; padding:14px 10px; text-decoration:none; color:white;
      transition:background 0.2s; gap:6px;
      " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.10)'">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span style="font-size:13px;font-weight:600;">Hourly</span>
      <span style="font-size:11px;opacity:0.75;">Forecast</span>
    </a>

    <a href="${tenDayHref}" style="
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18);
      border-radius:12px; padding:14px 10px; text-decoration:none; color:white;
      transition:background 0.2s; gap:6px;
      " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.10)'">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      <span style="font-size:13px;font-weight:600;">10-Day</span>
      <span style="font-size:11px;opacity:0.75;">Forecast</span>
    </a>

    <a href="${weekendHref}" style="
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18);
      border-radius:12px; padding:14px 10px; text-decoration:none; color:white;
      transition:background 0.2s; gap:6px;
      " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.10)'">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fb923c" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span style="font-size:13px;font-weight:600;">Weekend</span>
      <span style="font-size:11px;opacity:0.75;">Forecast</span>
    </a>

    <a href="${radarHref}" style="
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.18);
      border-radius:12px; padding:14px 10px; text-decoration:none; color:white;
      transition:background 0.2s; gap:6px;
      " onmouseover="this.style.background='rgba(255,255,255,0.2)'" onmouseout="this.style.background='rgba(255,255,255,0.10)'">
      <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#38bdf8" stroke-width="2"><circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/></svg>
      <span style="font-size:13px;font-weight:600;">Radar</span>
      <span style="font-size:11px;opacity:0.75;">Interactive Map</span>
    </a>

  </div>

  <div style="
    border-top: 1px solid rgba(255,255,255,0.12);
    padding-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  ">
    <span style="font-size:11px;color:#93c5fd;font-weight:600;text-transform:uppercase;letter-spacing:0.06em;margin-right:4px;">QUICK LINKS →</span>
    ${[
      ['Today\'s Forecast', forecastHref],
      ['Hourly', hourlyHref],
      ['10-Day', tenDayHref],
      ['Weekend', weekendHref],
      ['Interactive Radar', radarHref],
      ['Monthly', forecastHref.replace('/today/', '/monthly/')],
    ].map(([label, href]) => `
      <a href="${href}" style="
        background: rgba(96,165,250,0.18);
        border: 1px solid rgba(96,165,250,0.35);
        color: #bfdbfe;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: background 0.15s;
      " onmouseover="this.style.background='rgba(96,165,250,0.35)'" onmouseout="this.style.background='rgba(96,165,250,0.18)'">${label}</a>
    `).join('')}
  </div>
`;

element.insertBefore(panel, element.firstChild);


