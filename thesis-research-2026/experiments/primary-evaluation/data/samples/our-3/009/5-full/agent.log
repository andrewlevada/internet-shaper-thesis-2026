// Only add unique chips not already present
var existingChips = element.querySelectorAll('yt-chip-cloud-chip-renderer');
var existingLabels = [];
existingChips.forEach(function(chip) {
  var textEl = chip.querySelector('#chip-shape-container div');
  if (textEl) {
    existingLabels.push(textEl.textContent.trim());
  }
});

advancedChips.forEach(function(chipData) {
  // Check if this label already exists
  var alreadyExists = false;
  existingLabels.forEach(function(existing) {
    if (existing.toLowerCase() === chipData.label.toLowerCase()) {
      alreadyExists = true;
    }
  });
  
  if (!alreadyExists) {
    var newChip = document.createElement('yt-chip-cloud-chip-renderer');
    newChip.setAttribute('chip-style', 'STYLE_HOME_FILTER');
    
    var chipShapeContainer = document.createElement('div');
    chipShapeContainer.id = 'chip-shape-container';
    chipShapeContainer.setAttribute('class', 'style-scope yt-chip-cloud-chip-renderer');
    
    var chipShape = document.createElement('chip-shape');
    chipShape.setAttribute('class', 'ytChipShapeHost style-scope yt-chip-cloud-chip-renderer');
    
    var button = document.createElement('button');
    button.setAttribute('class', 'ytChipShapeButtonReset style-scope chip-shape');
    button.setAttribute('role', 'tab');
    
    var chipDiv = document.createElement('div');
    chipDiv.setAttribute('class', 'ytChipShapeChip ytChipShapeInactive ytChipShapeOnlyTextPadding style-scope chip-shape');
    chipDiv.textContent = chipData.label;
    
    button.appendChild(chipDiv);
    chipShape.appendChild(button);
    chipShapeContainer.appendChild(chipShape);
    newChip.appendChild(chipShapeContainer);
    
    element.appendChild(newChip);
  }
});
