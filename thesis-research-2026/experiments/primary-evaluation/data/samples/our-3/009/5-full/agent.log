html += '<div style="font-size:13px;font-weight:500;color:#606060;margin-bottom:8px;text-transform:uppercase;letter-spacing:0.5px;">Active Filters</div>';
html += '<div id="active-filters-list" style="display:flex;flex-wrap:wrap;gap:6px;"></div>';
html += '</div>';

sidebar.innerHTML = html;

// Add click handlers for chips
var chips = sidebar.querySelectorAll('.filter-chip');
chips.forEach(function(chip) {
  chip.addEventListener('click', function() {
    var isActive = this.classList.contains('active-filter-chip');
    
    // Toggle within same filter group
    var filterType = this.getAttribute('data-filter');
    var siblings = sidebar.querySelectorAll('[data-filter="' + filterType + '"]');
    
    if (!isActive) {
      siblings.forEach(function(sib) {
        sib.classList.remove('active-filter-chip');
        sib.style.background = '#f2f2f2';
        sib.style.color = '#030303';
        sib.style.borderColor = '#e5e5e5';
      });
      this.classList.add('active-filter-chip');
      this.style.background = '#e0e0e0';
      this.style.color = '#065fd4';
      this.style.borderColor = '#065fd4';
    } else {
      this.classList.remove('active-filter-chip');
      this.style.background = '#f2f2f2';
      this.style.color = '#030303';
      this.style.borderColor = '#e5e5e5';
    }
    
    // Update active filters display
    var activeChips = sidebar.querySelectorAll('.active-filter-chip');
    var activeDisplay = sidebar.querySelector('#active-filters-display');
    var activeList = sidebar.querySelector('#active-filters-list');
    
    if (activeChips.length > 0) {
      activeDisplay.style.display = 'block';
      activeList.innerHTML = '';
      activeChips.forEach(function(ac) {
        var badge = document.createElement('span');
        badge.style.cssText = 'display:inline-flex;align-items:center;gap:4px;padding:4px 10px;border-radius:12px;font-size:12px;background:#e8f0fe;color:#065fd4;';
        badge.textContent = ac.getAttribute('data-value');
        activeList.appendChild(badge);
      });
    } else {
      activeDisplay.style.display = 'none';
    }
  });
});

// Insert sidebar as first child
element.insertBefore(sidebar, element.firstChild);
