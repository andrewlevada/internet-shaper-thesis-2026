  "logic": "if (element.dataset.customButtonsAdded) return;\nelement.dataset.customButtonsAdded = 'true';\n\nconst channelInfo = element;\nconst textWrapper = channelInfo.parentElement;\n\n// Create button container\nconst btnContainer = document.createElement('div');\nbtnContainer.style.cssText = 'display:flex;gap:8px;margin-top:8px;padding-left:0;';\n\n// Get channel URL for subscribe\nconst channelLink = channelInfo.querySelector('#channel-thumbnail');\nconst channelUrl = channelLink ? channelLink.getAttribute('href') || channelLink.href : '';\n\n// Create Subscribe button\nconst subscribeBtn = document.createElement('button');\nsubscribeBtn.textContent = 'Subscribe';\nsubscribeBtn.style.cssText = 'background:#065fd4;color:#fff;border:none;border-radius:18px;padding:6px 16px;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;font-family:Roboto,Arial,sans-serif;white-space:nowrap;';\nsubscribeBtn.addEventListener('mouseenter', () => { subscribeBtn.style.background = '#0b5ad7'; });\nsubscribeBtn.addEventListener('mouseleave', () => { subscribeBtn.style.background = '#065fd4'; });\n\n// Subscribe icon (bell-like SVG)\nconst subIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\nsubIcon.setAttribute('width', '16');\nsubIcon.setAttribute('height', '16');\nsubIcon.setAttribute('viewBox', '0 0 24 24');\nsubIcon.setAttribute('fill', 'white');\nsubIcon.innerHTML = '<path d=\"M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10z\"/>';\nsubscribeBtn.prepend(subIcon);\n\nsubscribeBtn.addEventListener('click', function(e) {\n    e.preventDefault();\n    e.stopPropagation();\n    // Navigate to channel page where subscribe button is available\n    if (channelUrl) {\n        window.location.href = channelUrl;\n    }\n});\n\n// Create Add to Playlist button\nconst playlistBtn = document.createElement('button');\nplaylistBtn.textContent = 'Add to playlist';\nplaylistBtn.style.cssText = 'background:rgba(255,255,255,0.1);color:#fff;border:1px solid rgba(255,255,255,0.3);border-radius:18px;padding:6px 16px;font-size:13px;font-weight:500;cursor:pointer;display:flex;align-items:center;gap:6px;font-family:Roboto,Arial,sans-serif;white-space:nowrap;';\nplaylistBtn.addEventListener('mouseenter', () => { playlistBtn.style.background = 'rgba(255,255,255,0.2)'; });\nplaylistBtn.addEventListener('mouseleave', () => { playlistBtn.style.background = 'rgba(255,255,255,0.1)'; });\n\n// Playlist icon SVG\nconst plIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\nplIcon.setAttribute('width', '16');\nplIcon.setAttribute('height', '16');\nplIcon.setAttribute('viewBox', '0 0 24 24');\nplIcon.setAttribute('fill', 'white');\nplIcon.innerHTML = '<path d=\"M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z\"/>';\nplaylistBtn.prepend(plIcon);\n\nplaylistBtn.addEventListener('click', function(e) {\n    e.preventDefault();\n    e.stopPropagation();\n    // Find and click the three-dot menu, then find \"Add to playlist\" in the dropdown\n    const videoRenderer = textWrapper.closest('ytd-video-renderer');\n    if (!videoRenderer) return;\n\n    const menuButton = videoRenderer.querySelector('#menu .dropdown-trigger button');\n    if (menuButton) {\n        menuButton.click();\n        // Wait for menu to open and click \"Add to playlist\"\n        setTimeout(() => {\n            const menuItems = document.querySelectorAll('ytd-menu-service-item-renderer, yt-button-shape');\n            for (const item of menuItems) {\n                const text = item.textContent.trim();\n                if (text.includes('Add to playlist') || text.includes('Save')) {\n                    // Find the clickable button inside\n                    const btn = item.querySelector('button') || item;\n                    btn.click();\n                    break;\n                }\n            }\n        }, 300);\n    }\n});\n\nbtnContainer.appendChild(subscribeBtn);\nbtnContainer.appendChild(playlistBtn);\n\ntextWrapper.insertBefore(btnContainer, textWrapper.querySelector('.metadata-snippet-container'));"
