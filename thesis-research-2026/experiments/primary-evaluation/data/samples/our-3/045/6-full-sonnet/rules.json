{
	"rules": [
		{
			"label": "Expand TOC by default",
			"query_selector": "section[id^='article-toc'] details",
			"logic": "element.setAttribute('open', 'true');"
		},
		{
			"label": "Hide TOC dropdown toggle",
			"query_selector": "section[id^='article-toc'] details > summary",
			"logic": "element.style.display = 'none';"
		}
	],
	"result": {
		"success": true,
		"log": "rules applied in real-time"
	}
}
