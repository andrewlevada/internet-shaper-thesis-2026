shareBtn.setAttribute('aria-label', 'Share pin');
shareBtn.title = 'Share';
shareBtn.style.cssText = 'width:32px;height:32px;border-radius:50%;border:none;background:rgba(255,255,255,0.9);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,0.2);transition:background 0.2s;';
shareBtn.onmouseover = function() { this.style.background = 'rgba(255,255,255,1)'; };
shareBtn.onmouseout = function() { this.style.background = 'rgba(255,255,255,0.9)'; };

var shareSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
shareSvg.setAttribute('width', '16');
shareSvg.setAttribute('height', '16');
shareSvg.setAttribute('viewBox', '0 0 24 24');
shareSvg.setAttribute('fill', 'none');
shareSvg.setAttribute('stroke', '#333');
shareSvg.setAttribute('stroke-width', '2');
shareSvg.setAttribute('stroke-linecap', 'round');
shareSvg.setAttribute('stroke-linejoin', 'round');

var c1 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
c1.setAttribute('cx', '18'); c1.setAttribute('cy', '5'); c1.setAttribute('r', '3');
var c2 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
c2.setAttribute('cx', '6'); c2.setAttribute('cy', '12'); c2.setAttribute('r', '3');
var c3 = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
c3.setAttribute('cx', '18'); c3.setAttribute('cy', '19'); c3.setAttribute('r', '3');
var l1 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
l1.setAttribute('x1', '8.59'); l1.setAttribute('y1', '13.51'); l1.setAttribute('x2', '15.42'); l1.setAttribute('y2', '10.58');
var l2 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
l2.setAttribute('x1', '15.41'); l2.setAttribute('y1', '10.59'); l2.setAttribute('x2', '8.59'); l2.setAttribute('y2', '17.42');
shareSvg.appendChild(c1); shareSvg.appendChild(c2); shareSvg.appendChild(c3);
shareSvg.appendChild(l1); shareSvg.appendChild(l2);
shareBtn.appendChild(shareSvg);

var downloadBtn = document.createElement('button');
downloadBtn.setAttribute('aria-label', 'Download pin');
downloadBtn.title = 'Download';
downloadBtn.style.cssText = 'width:32px;height:32px;border-radius:50%;border:none;background:rgba(255,255,255,0.9);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,0.2);transition:background 0.2s;';
downloadBtn.onmouseover = function() { this.style.background = 'rgba(255,255,255,1)'; };
downloadBtn.onmouseout = function() { this.style.background = 'rgba(255,255,255,0.9)'; };

var dlSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
dlSvg.setAttribute('width', '16');
dlSvg.setAttribute('height', '16');
dlSvg.setAttribute('viewBox', '0 0 24 24');
dlSvg.setAttribute('fill', 'none');
dlSvg.setAttribute('stroke', '#333');
dlSvg.setAttribute('stroke-width', '2');
dlSvg.setAttribute('stroke-linecap', 'round');
dlSvg.setAttribute('stroke-linejoin', 'round');

var p1 = document.createElementNS('http://www.w3.org/2000/svg', 'path');
p1.setAttribute('d', 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4');
var p2 = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
p2.setAttribute('points', '7 10 12 15 17 10');
var p3 = document.createElementNS('http://www.w3.org/2000/svg', 'line');
p3.setAttribute('x1', '12'); p3.setAttribute('y1', '15'); p3.setAttribute('x2', '12'); p3.setAttribute('y2', '3');
dlSvg.appendChild(p1); dlSvg.appendChild(p2); dlSvg.appendChild(p3);
downloadBtn.appendChild(dlSvg);

var pinLink = element.querySelector('[data-test-id="deeplink-wrapper"] a');
var pinHref = '';
if (pinLink) {
  pinHref = pinLink.getAttribute('href') || '';
}

shareBtn.addEventListener('click', function(e) {
  e.preventDefault();
  e.stopPropagation();
  if (navigator.share && pinHref) {
    navigator.share({ title: 'Pinterest Pin', url: pinHref }).catch(function() {});
  } else if (pinHref) {
    navigator.clipboard.writeText(pinHref).then(function() {
      shareBtn.title = 'Link copied!';
      setTimeout(function() { shareBtn.title = 'Share'; }, 2000);
    });
  }
});

downloadBtn.addEventListener('click', function(e) {
  e.preventDefault();
  e.stopPropagation();
  var imgEl = element.querySelector('[data-test-id="pincard-storyPin-without-link"] img, .e2jAjp img');
  if (imgEl && imgEl.src) {
    var a = document.createElement('a');
    a.href = imgEl.src;
    a.download = 'pin-image.jpg';
    a.target = '_blank';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }
});

actionsContainer.appendChild(shareBtn);
actionsContainer.appendChild(downloadBtn);
element.appendChild(actionsContainer);

