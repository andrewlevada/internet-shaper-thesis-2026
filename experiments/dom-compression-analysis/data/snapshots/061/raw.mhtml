.nav-menu--slideout { transition: transform 0.3s ease-in-out; transform: tr=
anslate3d(18.25em, 0px, 0px); backface-visibility: hidden; transform-style:=
 preserve-3d; box-shadow: rgba(0, 0, 0, 0.2) -1px 0px 1px; width: 18em; dis=
play: block; height: 100%; position: fixed; inset: 0px -18.25em 0px auto; z=
-index: 200; }

.nav-menu--slideout .nav-menu__list { padding-left: 1.5em; position: absolu=
te; overflow: hidden auto; inset: 0px; }

.nav-menu--slideout.is-open { right: 0px; transform: translate3d(0px, 0px, =
