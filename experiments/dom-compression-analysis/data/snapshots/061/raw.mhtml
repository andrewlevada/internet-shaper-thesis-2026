.csstransforms3d .nav-menu--slideout { right: 0px; }

.is-legacy-android .nav-menu--slideout { position: absolute; }

.notification { transition: 0.2s ease-out; display: table; left: 0px; opaci=
ty: 0; position: fixed; top: -64px; width: 100%; z-index: 500; }

.notification.is-showing { opacity: 0.8; top: 40px; }

.notification__wrap { display: table-cell; width: 100%; }

.notification__text { border-radius: 5px; background: rgb(51, 51, 51); colo=
r: rgb(255, 255, 255); display: table; margin: 0px auto; max-width: 300px; =
padding: 10px 45px; text-align: center; }

.sep--small, .sep--before::before, .sep--after::after, .sep, .zcm__sep { bo=
rder-left: 1px solid rgb(208, 208, 208); margin: 0px 1em; display: inline-b=
lock; vertical-align: baseline; position: relative; top: 0.15em; float: non=
e; height: 1em; width: 0px; }

.sep--before::before, .sep--after::after { content: ""; }

.sep--small { border-color: rgb(229, 229, 229); height: 0.75em; margin: 0px=
 0.35em; top: 0px; }

.switch { border-radius: 10px; position: relative; height: 16px; width: 26p=
x; background: rgb(170, 170, 170); cursor: pointer; }

.switch.is-on { background: rgb(68, 149, 212); }

.switch__knob { border-radius: 50%; transition: 0.1s, linear, left 0.3s eas=
e-in-out; position: absolute; display: block; left: 2px; top: 2px; height: =
12px; width: 12px; background-color: rgb(255, 255, 255); }

.is-on .switch__knob { left: 12px; }

.switch--checkmark { width: 32px; }

.switch--checkmark::before { speak: none; font-style: normal; font-variant:=
 normal; text-transform: none; -webkit-font-smoothing: antialiased; content=
: "=E2=9C=93"; position: absolute; top: 2px; left: 5px; color: rgb(255, 255=
, 255); font-size: 12px; line-height: 1; opacity: 0; transition: opacity 30=
0ms ease-in; font-family: ddg-serp-icons !important; font-weight: var(--sds=
-font-weight-normal, normal) !important; text-decoration: none !important; =
}

.switch--checkmark.switch--large::before { top: 6px; left: 7px; }

.switch--checkmark.is-on::before { opacity: 1; }

.switch--checkmark.is-on .switch__knob { left: 18px; }

.switch--large { border-radius: 30px; height: 24px; width: 44px; }

.switch--large .switch__knob { height: 20px; width: 20px; }

.switch--large.is-on .switch__knob { left: 22px; }

