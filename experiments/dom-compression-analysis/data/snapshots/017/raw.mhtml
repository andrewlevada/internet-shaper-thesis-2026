@keyframes notification-fade-in {=20
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes notification-fade-out {=20
  0% { opacity: 1; }
  25% { opacity: 0; }
  100% { opacity: 0; }
}

@keyframes notification-slide-in {=20
  0% { opacity: 0; transform: translateY(-100%); }
  25% { opacity: 0; }
  75% { opacity: 1; }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes notification-slide-out {=20
  0% { opacity: 1; transform: translateY(0px); }
  75% { opacity: 0; }
  100% { opacity: 0; transform: translateY(-100%); }
}

@keyframes notification-slide-up-in {=20
  0% { opacity: 0; transform: translateY(100%); }
  25% { opacity: 0; }
  75% { opacity: 1; }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes notification-slide-up-out {=20
  0% { opacity: 1; transform: translateY(0px); }
  75% { opacity: 0; }
  100% { opacity: 0; transform: translateY(100%); }
}

@keyframes notification-pop-in {=20
  0% { opacity: 0; transform: scale(0); }
  25% { opacity: 0; }
  75% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes notification-pop-out {=20
  0% { opacity: 1; transform: scale(1); }
  75% { opacity: 0; }
  100% { opacity: 0; transform: scale(0); }
}

@keyframes notification-drop-in {=20
  0% { opacity: 0; transform: scale(2); }
  75% { opacity: 1; }
  100% { opacity: 1; transform: scale(1); }
}

@keyframes notification-drop-out {=20
