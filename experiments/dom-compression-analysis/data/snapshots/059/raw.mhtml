@charset "utf-8";

.specs-and-stats {
  & .container { max-width: 1600px; padding-right: 5%; padding-left: 5%; wi=
dth: 90%; box-sizing: content-box; }
  & .row { display: flex; flex-direction: column; }
  & .card-metrics { font-size: 71px; font-weight: 600; line-height: 84px; }
  & .icon { width: 80px; }
  & .compact-heading { margin-top: auto; }
  & .center-heading { justify-content: center; }
  & .card-paragraph { font-size: 14px; line-height: 20px; font-weight: 400;=
 margin: 0px; }
  & .title-content { gap: 24px; }
  & .image-gap { gap: 1rem; }
}

sup > a[href]:focus { margin: 0.375rem 3px 3px; font-size: 10px; vertical-a=
lign: middle; }

.specs-and-stats.dark-theme { --dark-mode-color: #0a0520; background-color:=
 var(--dark-mode-color); --ds-theme-material-color-background: #33303d; }

cascade-hero-cta.vertical-layout { --ds-hero-cta-layout-align-items: start;=
 --ds-hero-cta-layout-flex-direction: column; }

@media (forced-colors: active) {
  @media (prefers-color-scheme: light) {
  .specs-and-stats.dark-theme cascade-hero-cta .icon { filter: invert(1); }
}
  @media (prefers-color-scheme: dark) {
  .specs-and-stats.light-theme cascade-hero-cta .icon { filter: invert(1); =
}
}
}

@media (max-width: 1083.99px) {
  .specs-and-stats .card-metrics { font-size: 50px; line-height: 60px; }
  .specs-and-stats .icon { width: 56px; }
}

@media (min-width: 541px) and (max-width: 1083px) {
  .specs-and-stats { padding: 20px 0px; }
}

@media (min-width: 1084px) {
  .specs-and-stats { padding: 40px 0px; }
}
