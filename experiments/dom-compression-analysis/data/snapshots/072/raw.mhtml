.skeleton, .skeleton__item, .skeleton__lines { display: flex; flex-directio=
n: column; }

.skeleton__title, .skeleton__tag, .skeleton__feed, .skeleton__button, .skel=
eton__line { background-color: rgb(217, 217, 217); }

.skeleton { padding: 32px 24px; width: 100%; gap: 20px; }

@media print, screen and (min-width: 64em) {
  .skeleton { flex-direction: row; }
}

.skeleton__title { width: 100%; height: 40px; border-radius: 24px; }

.skeleton__item { gap: 41px; flex: 1 1 0%; }

.skeleton__item:nth-child(1) .skeleton__tag { width: 122px; }

.skeleton__item:nth-child(2) .skeleton__tag { width: 86px; }

.skeleton__item:nth-child(3) .skeleton__tag { width: 174px; }

@media print, screen and (min-width: 64em) {
  .skeleton__item { margin-top: auto; }
}

.skeleton__tag { height: 22px; border-radius: 20px; }

@media print, screen and (min-width: 64em) {
  .skeleton__tag { order: 2; }
}

.skeleton__content { display: flex; gap: 12px; }

@media print, screen and (min-width: 64em) {
  .skeleton__content { order: 3; }
}

.skeleton__feed { width: 133px; height: 100px; border-radius: 12px; }

@media print, screen and (min-width: 44.5em) {
  .skeleton__feed { width: 50%; height: 200px; }
}

@media print, screen and (min-width: 64em) {
  .skeleton__feed { width: 100%; height: 300px; }
}

.skeleton__lines { width: 100%; gap: 4px; }

@media print, screen and (min-width: 44.5em) {
  .skeleton__lines { width: 50%; }
}

@media print, screen and (min-width: 64em) {
  .skeleton__lines { display: none; }
}

.skeleton__line { width: 100%; height: 12px; border-radius: 4px; }

.skeleton__line:nth-child(4) { width: 70%; }

.skeleton__line:last-child { margin-top: 22px; width: 70%; }

.skeleton__button { width: 100%; height: 48px; border-radius: 5px; }

@media print, screen and (min-width: 64em) {
  .skeleton__button { order: 1; }
}

