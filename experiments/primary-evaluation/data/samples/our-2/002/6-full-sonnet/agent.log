// Only inject once
if (element.dataset.videoInjected === 'true') return;

// Find the headline link to get the video slug
const titleLink = element.closest('[data-testid="ContentMediaModule"]').querySelector('.Header--impactTitleHref--vvfgD');
if (!titleLink) return;

const href = titleLink.getAttribute('href') || '';

// The primary link inside the primary container
const primaryLink = element.querySelector('a.mediaLink');
if (!primaryLink) return;

const imgWrapper = element.querySelector('.Image--intrinsicRatioRoot--L7BRj');
if (!imgWrapper) return;

// Build a responsive autoplay video iframe using Weather Channel's embed pattern.
// Use the story href to construct a generic video embed.
// We embed an iframe pointing to the story page itself as a preview iframe,
// or construct an HTML5 video overlay using a public .mp4 preview URL pattern.
// Instead, we'll build a clean autoplay YouTube-style iframe placeholder using
// the Weather Channel's own video embed endpoint.

// Extract the video path slug for the embed URL
// Weather.com video URLs follow: /category/video/slug or /category/news/video/slug
const slugMatch = href.match(/\/video\/([^/?#]+)/);
const videoSlug = slugMatch ? slugMatch[1] : null;

// Create a container that matches the existing 16:9 ratio wrapper
const container = document.createElement('div');
container.style.cssText = 'position:relative;width:100%;padding-top:56.25%;border-radius:8px;overflow:hidden;background:#000;';

if (videoSlug) {
  // Use weather.com's standard embed iframe
  const iframe = document.createElement('iframe');
  iframe.src = 'https://weather.com/embed/video/' + videoSlug + '?autoplay=true&mute=1';
  iframe.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;border:none;';
  iframe.setAttribute('allowfullscreen', 'true');
  iframe.setAttribute('allow', 'autoplay; fullscreen');
  iframe.setAttribute('title', 'Top Story Video');
  container.appendChild(iframe);
} else {
  // Fallback: embed the story page as a video preview via the existing image but add a play overlay
  const img = imgWrapper.querySelector('img');
  const imgSrc = img ? (img.src || img.getAttribute('data-src') || '') : '';

  const fallbackImg = document.createElement('img');
  fallbackImg.src = imgSrc.replace('width=320','width=800');
  fallbackImg.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;';
  container.appendChild(fallbackImg);

  const playBtn = document.createElement('div');
  playBtn.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:72px;height:72px;background:rgba(0,0,0,0.65);border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;';
  playBtn.innerHTML = '<svg viewBox="0 0 24 24" width="38" height="38" fill="white"><path d="M8 5v14l11-7z"/></svg>';
  playBtn.onclick = () => { window.open('https://weather.com' + href, '_self'); };
  container.appendChild(playBtn);
}

// Replace the existing image root with our video container
imgWrapper.style.display = 'none';
const mediaImgDiv = imgWrapper.closest('[data-testid="ContentMediaImage"]');
if (mediaImgDiv && !mediaImgDiv.querySelector('.custom-video-container')) {
  container.classList.add('custom-video-container');
  mediaImgDiv.appendChild(container);
}

element.dataset.videoInjected = 'true';

