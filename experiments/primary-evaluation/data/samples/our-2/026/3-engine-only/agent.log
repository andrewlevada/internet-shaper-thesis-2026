  if (!match) return;

  var num = parseFloat(match[1]);
  var suffix = match[2].toUpperCase();
  if (suffix === 'K') num *= 1000;
  else if (suffix === 'M') num *= 1000000;

  var allArticles = document.querySelectorAll('article.Layout-sc-1xcs6mc-0.ghbJdj');
  var viewers = [];
  allArticles.forEach(function(card) {
