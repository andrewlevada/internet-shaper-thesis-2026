      imageLink.style.position = 'relative';
      imageLink.insertBefore(badge, imageLink.firstChild);
    }
  } else {
    // Remove badge if this card no longer qualifies
    const existingBadge = element.querySelector('.top-live-badge');
    if (existingBadge) existingBadge.remove();
  }
