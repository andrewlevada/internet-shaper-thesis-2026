    (function() {
  // Parse viewer count from this card's stat element
  const statEl = element.querySelector('.tw-media-card-stat');
  if (!statEl) return;
  
  const text = statEl.textContent.trim();
  if (!text || !text.includes('viewer')) return;
  
  // Parse viewer count
  let viewers = 0;
  const match = text.match(/^([\d.]+)\s*([KMGT]?)\s*viewers?/i);
  if (match) {
    const num = parseFloat(match[1]);
    const suffix = match[2].toUpperCase();
    if (suffix === 'K') viewers = num * 1000;
    else if (suffix === 'M') viewers = num * 1000000;
    else if (suffix === 'G') viewers = num * 1000000000;
    else viewers = num;
  }
  
  // Collect all viewer counts from visible cards on the page
  const allCards = document.querySelectorAll('.ScWrapper-sc-1wvuch4-0');
  const viewerCounts = [];
  
  allCards.forEach(function(card) {
    const s = card.querySelector('.tw-media-card-stat');
    if (s && s.textContent.trim()) {
      const t = s.textContent.trim();
      const m = t.match(/^([\d.]+)\s*([KMGT]?)\s*viewers?/i);
      if (m) {
        let v = 0;
        const n = parseFloat(m[1]);
        const sf = m[2].toUpperCase();
        if (sf === 'K') v = n * 1000;
        else if (sf === 'M') v = n * 1000000;
        else if (sf === 'G') v = n * 1000000000;
        else v = n;
        viewerCounts.push(v);
      }
    }
  });
  
  // Sort descending and find the threshold for top streams
  // Top streams are those in the top ~20% or above a high percentile
  viewerCounts.sort(function(a, b) { return b - a; });
  
  if (viewerCounts.length === 0) return;
  
  // Determine threshold: use top 15-20% of streams by viewer count
  const topIndex = Math.max(1, Math.floor(viewerCounts.length * 0.15));
  const threshold = viewerCounts[topIndex - 1];
  
  // Check if this card qualifies as a top stream
  if (viewers >= threshold && viewers > 0) {
    // Remove existing badge if present (idempotency)
    const existingBadge = element.querySelector('.top-live-badge');
    if (existingBadge) existingBadge.remove();
    
    // Create the badge
    const badge = document.createElement('div');
    badge.className = 'top-live-badge';
    badge.textContent = 'TOP LIVE';
    badge.style.cssText = 
