[
	{
		"label": "Shrink header height",
		"query_selector": "[data-test-id=\"unauth-header\"]",
		"logic": "element.style.height = '48px';"
	},
	{
		"label": "Shrink header inner row",
		"query_selector": "[data-test-id=\"unauth-header\"] > div",
		"logic": "element.style.height = '48px';"
	},
	{
		"label": "Shrink header spacer div",
		"query_selector": "header > div:last-of-type",
		"logic": "element.style.height = '48px';"
	},
	{
		"label": "Shrink Explore tab height",
		"query_selector": "[data-test-id=\"ideas-tab\"]",
		"logic": "element.style.height = '32px'; element.style.minWidth = '48px';"
	},
	{
		"label": "Shrink search bar height",
		"query_selector": "[data-test-id=\"search-box-container\"] .g8WGSl",
		"logic": "element.style.height = '32px';"
	},
	{
		"label": "Shrink search input font",
		"query_selector": "[data-test-id=\"search-box-input\"]",
		"logic": "element.style.fontSize = '13px';"
	},
	{
		"label": "Shrink header button text",
		"query_selector": "[data-test-id=\"ideas-tab\"] div, [data-test-id=\"login-button\"] div, [data-test-id=\"signup-button\"] div",
		"logic": "element.style.fontSize = '13px';"
	},
	{
		"label": "Shrink Pinterest logo size",
		"query_selector": "[data-test-id=\"unauth-header-logo\"] a",
		"logic": "element.style.transform = 'scale(0.75)'; element.style.transformOrigin = 'left center';"
	}
]
