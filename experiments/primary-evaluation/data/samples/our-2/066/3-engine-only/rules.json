[
	{
		"label": "Shrink header height",
		"query_selector": "header > div[data-test-id=\"unauth-header\"] > div[style*=\"height:80px\"]",
		"logic": "element.style.height = '56px';"
	},
	{
		"label": "Shrink search bar height",
		"query_selector": "div[data-test-id=\"search-box-container\"] > div > div[style*=\"height:48px\"]",
		"logic": "element.style.height = '36px';"
	},
	{
		"label": "Shrink header nav row",
		"query_selector": "header > div[data-test-id=\"unauth-header\"] > div[style*=\"height:80px\"] > div > div > div",
		"logic": "element.style.height = '56px';"
	},
	{
		"label": "Shrink Explore tab",
		"query_selector": "div[data-test-id=\"ideas-tab\"]",
		"logic": "element.style.height = '36px';"
	},
	{
		"label": "Shrink page title text",
		"query_selector": "div[data-test-id=\"ideas-root-header\"] h1",
		"logic": "element.style.fontSize = '18px';\nelement.style.marginTop = '4px';\nelement.style.marginBottom = '4px';"
	},
	{
		"label": "Shrink section headers",
		"query_selector": "section h2, div > h2.wyEmcc",
		"logic": "element.style.fontSize = '16px';\nelement.style.marginTop = '4px';\nelement.style.marginBottom = '4px';"
	},
	{
		"label": "Shrink header buttons text",
		"query_selector": "div[data-test-id=\"login-button\"] .WuRgKB, div[data-test-id=\"signup-button\"] .lIkAnG",
		"logic": "element.style.fontSize = '13px';"
	},
	{
		"label": "Shrink search input font",
		"query_selector": "input[data-test-id=\"search-box-input\"]",
		"logic": "element.style.fontSize = '14px';"
	},
	{
		"label": "Shrink Explore tab text",
		"query_selector": "a[data-test-id=\"ideas-tab\"] .WuRgKB",
		"logic": "element.style.fontSize = '13px';"
	},
	{
		"label": "Reduce header spacing",
		"query_selector": "header + div[style*=\"height:80px\"]",
		"logic": "element.style.height = '56px';"
	}
]
