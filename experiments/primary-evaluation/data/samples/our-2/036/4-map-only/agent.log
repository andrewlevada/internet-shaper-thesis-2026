сказывать. Ищу {{Query}}.","С картинкой будет ещё понятнее. Сейчас найду подходящую: {{Query}}.","Здесь просится картинка, сейчас найду: {{Query}}.","Кажется, здесь нужна картинка. Ищу {{Query}}.","Будет понятнее, если добавить картинку. Ищу {{Query}}."],"videos":["Придумала, это лучше всего показать с помощью видео! Сейчас найду хорошее: {{Query}}.","Тут я покажу видео. Посмотрим, что интересного есть в поиске: {{Query}}.","Здесь стоит добавить видео. Ищу {{Query}}.","Пожалуй, самое время добавить видео: {{Query}}.","Ищу {{Query}}. Отлично, нашлось. Сейчас добавлю."]},"interval":1000}},"videoStoreProps":{"contextParams":{"tld":"ru","language":"ru","user_time":{"epoch":"1779011910","__is_plain":1,"to_iso":"2026-05-17T11:58:30+0200","tz":"Europe/Amsterdam"},"shouldUseHighresPreview":true,"shouldCutSnippetTitle":true,"shouldUseCleanServiceLinks":true,"shouldShowPlayIcon":true,"shouldShowAdultBadge":true,"isSummaryDisabled":true,"shouldRenderBroSummaryApiContainer":false},"xlThumbRedesign":false},"snackbarStoreProps":{},"dialogStoreProps":{"baseUrl":"https://yandex.ru/neuralsearch/api?lr=10466&amp;reqid=1779011910107727-4416894131561686610-balancer-l7leveler-kubr-yp-sas-139-BAL","yabsData":""},"forceNeuroActivate":false,"extralinksItems":[{"variant":"futurisAbout","index":1,"target":"_blank"},{"variant":"futurisDisclaimer","index":2}],"startDialogAdditionalParams":{"extraInfo":{"isBsoResearchAnswer":true}},"aliceProStoreProps":{"disabled":false,"hasAlicePro":false,"suffix":"r","isVisiblePromo":false,"leftLimits":null,"maxLimit":null,"expirationDate":null,"needUpdateCookie":false},"fromOpen":"teaser_bsa","fetchProps":{"userId":"2616866101779011910","searchQuery":"cats","sessionId":"2616866101779011910_1779011910510","codedRequestContext":"","ajaxCallback":"/search/generative_answer","debugReqid":false,"additionalParams":{"from":"teaser_bsa"}},"logNode":{"name":"futuris-search-gen-rsr"},"baobab":{"parentNode":{"context":{"genInfo":{"prefix":"1_34j4w02-0-1"},"ui":"desktop