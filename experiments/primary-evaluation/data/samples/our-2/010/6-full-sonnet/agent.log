1 rule(s):
[1] Show pin description & domain — [data-test-id="pinWrapper"]
    
// Avoid duplicate injection
if (element.querySelector('.ext-pin-info-bar')) return;

// Get description from aria-label on the main anchor
const anchor = element.querySelector('a[aria-label]');
if (!anchor) return;
const description = anchor.getAttribute('aria-label');
if (!description) return;

// Try to get domain from image src if it's an external link
const img = element.querySelector('img[src]');
let domain = 'pinterest.com';
if (img) {
  const src = img.getAttribute('src') || '';
  // Check if there's an external URL encoded in the src (some pins link to external sites)
  // Pinterest CDN images are from i.pinimg.com, so default to pinterest.com
  const externalMatch = src.match(/https?:\/\/(?!i\.pinimg\.com)([^\/]+)/);
  if (externalMatch) {
    domain = externalMatch[1];
  }
}

// Create the info bar container
const bar = document.createElement('div');
bar.className = 'ext-pin-info-bar';
bar.style.cssText = [
  'background: rgba(255,255,255,0.97)',
  'border-top: 1px solid #e0e0e0',
  'padding: 7px 10px 8px',
  'box-sizing: border-box',
  'width: 100%',
  'pointer-events: none',
  'user-select: none'
].join(';');

// Description line
const descEl = document.createElement('div');
descEl.className = 'ext-pin-desc';
descEl.textContent = description;
descEl.style.cssText = [
  'font-size: 12px',
  'line-height: 1.4',
  'color: #111',
  'font-weight: 500',
  'display: -webkit-box',
  '-webkit-line-clamp: 2',
  '-webkit-box-orient: vertical',
  'overflow: hidden',
  'margin-bottom: 4px',
  'font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
].join(';');

// Domain line
const domainEl = document.createElement('div');
domainEl.className = 'ext-pin-domain';
domainEl.textContent = '🌐 ' + domain;
domainEl.style.cssText = [
  'font-size: 11px',
  'color: #767676',
  'font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
  'letter-spacing: 0.01em',
  'white-space: nowrap',
  'overflow: hidden',
  'text-overflow: ellipsis'
].join(';');

bar.appendChild(descEl);
bar.appendChild(domainEl);

// Insert after the deeplink-wrapper (after the image area)
const imageWrapper = element.querySelector('[data-test-id="deeplink-wrapper"]');
if (imageWrapper && imageWrapper.parentNode) {
  imageWrapper.parentNode.insertBefore(bar, imageWrapper.nextSibling);
}


