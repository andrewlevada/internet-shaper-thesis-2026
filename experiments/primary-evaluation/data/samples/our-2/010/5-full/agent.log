    // Get the pin ID and aria-label from this pin element
var pinId = element.getAttribute('data-test-pin-id');
if (!pinId) return;

// Find all links within this pin to get description and href
var links = element.querySelectorAll('a[href*="/pin/"]');
if (!links.length) return;

// Get the aria-label (description) from the first link
var description = links[0].getAttribute('aria-label') || '';
if (!description) return;

// Find the image to get source URL for domain extraction
var img = element.querySelector('[data-test-id="pinrep-image"] img');
var imageUrl = img ? img.getAttribute('src') || img.getAttribute('srcset') : '';

// Find or create the info container - place it in the bottom section (.To17G1)
var bottomSection = element.querySelector('.To17G1');
if (!bottomSection) return;

// Check if we already added our info container
var existingInfo = element.querySelector('[data-pin-info-added]');
if (existingInfo) return;

// Create the info container
var infoContainer = document.createElement('div');
infoContainer.setAttribute('data-pin-info-added', 'true');
infoContainer.style.cssText = 'padding: 6px 8px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; border-top: 1px solid #eee;';

// Create description element (truncate if too long)
var descEl = document.createElement('div');
descEl.style.cssText = 'font-size: 12px; color: #333; line-height: 1.4; margin-bottom: 4px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;';
descEl.textContent = description;

// Create domain/pin reference element
var sourceEl = document.createElement('div');
sourceEl.style.cssText = 'font-size: 11px; color: #888; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;';

// Extract domain info from image URL if available
var domain = 'pinterest.com';
if (imageUrl) {
  try {
    var urlParts = imageUrl.split(' ')[0]; // take first URL from srcset
    var urlObj = new URL(urlParts);
    domain = urlObj.hostname;
  } catch(e) {}
}

sourceEl.textContent = '📌 ' + domain + '/pin/' + pinId;

infoContainer.appendChild(descEl);
infoContainer.appendChild(sourceEl);

// Insert at the beginning of the bottom section
bottomSection.insertBefore(infoContainer, bottomSection.firstChild);


