"Travel\"],\"PINKBIKE__Travel\":[\"Sports\",\"Travel\"],\"OUTSIDE__Active Families\":[\"Outdoor\"],\"BACKPACKER__Arkansas Trails\":[\"Outdoor\",\"Travel\"],\"VEGETARIAN_TIMES__Community\":[\"Food\",\"Cooking\"]},\"providerId\":\"f7e99c29-139d-4c89-a7f1-eede4da16780\",\"interestsId\":\"2580bd94-9ff5-4a7b-9fdf-6def2d577c3f\",\"backgroundId\":\"47497c09-7242-4c3f-a68d-ea8180754e4f\",\"collectionId\":\"4cd8ee5a-d704-4d55-9c4f-9df05746aa80\",\"partnerByline\":[\"<span>This article originally appeared on <a href='\uFF04{outsideArticleUrl}'><img className='partner-logo' src='https://s.w-x.co/outside_logo.png'></a></span>\"]}},\"id\":\"883207b1-1d04-48ce-8448-adca78deda17\",\"relationships\":{\"locale\":{\"data\":null},\"twc_config_type\":{\"data\":null}},\"type\":\"state_config\"}},{\"_id\":\"f347d91c-0a0a-4204-b386-4ee07beb09b1\",\"data\":{\"attributes\":{\"active\":true,\"environment\":null,\"name\":\"loveToKnowRssConfig\",\"value\":{\"partner\":\"loveToKnow\",\"providerId\":\"8b99cb70-b7c2-4bc1-90fd-202dc66da6ed\",\"interestsId\":\"2580bd94-9ff5-4a7b-9fdf-6def2d577c3f\",\"partnerLogo\":\"https://s.w-x.co/loveToKnow.svg\",\"blacklistedFields\":[\"field_pcoll\",\"field_provider\"],\"defaultSEOKeywords\":\"Home, Garden\",\"defaultTag\":\"LoveToKnow\",\"backgroundId\":\"47497c09-7242-4c3f-a68d-ea8180754e4f\",\"collectionId\":\"a164281a-146e-49c6-b4d4-b97516d8a1f9\",\"partnerByline\":[\"<span>This article originally appeared on <a href='\uFF04{loveToKnowArticleUrl}'><img className='partner-logo' src='\uFF04{partnerLogo}'></a></span>\"],\"collectionName\":\"lovetoknow\"}},\"id\":\"f347d91c-0a0a-4204-b386-4ee07beb09b1\",\"relationships\":{\"locale\":{\"data\":null},\"twc_config_type\":{\"data\":null}},\"type\":\"state_config\"}},{\"_id\":\"df7ba57c-084c-46d2-8fbe-2780376ee7b1\",\"data\":{\"attributes\":{\"active\":true,\"environment\":null,\"name\":\"loveToKnowPetsRss\",\"value\":{\"defaultSEOKeywords\":\"Pets\",\"tagsMap\":{\"pet\":\"Pets\",\"Cats\":[\"Cats\",\"Pets\"],\"Dogs\":[\"Dogs\",\"Pets\"],\"Pets\":[\"Pets\"]},\"partnerLogo\":\"https://s.w-x.co/loveToKnowPets.svg\",\"partnerByline\":[\"<span>This article originally appeared on <a href='\uFF04{loveToKnowArticleUrl}'><img className='partner-logo' src='\uFF04{partnerLogo}'></a></span>\"],\"backgroundId\":\"\",\"collectionId\":\"a164281a-146e-49c6-b4d4-b97516d8a1f9\",\"collectionName\":\"lovetoknow\",\"partner\":\"loveToKnow\",\"providerId\":\"8b99cb70-b7c2-4bc1-90fd-202dc66da6ed\",\"interestsId\":\"\"}},\"id\":\"df7ba57c-084c-46d2-8fbe-2780376ee7b1\",\"relationships\":{\"locale\":{\"data\":null},\"twc_config_type\":{\"data\":null}},\"type\":\"state_config\"}},{\"_id\":\"cac4f5e2-c01e-4c21-9654-e44efd4ca0df\",\"data\":{\"attributes\":{\"active\":false,\"environment\":null,\"name\":\"WU FAQ Data\",\"value\":{\"sections\":[{\"title\":\"Ad Free Subscriptions\",\"content\":[{\"question\":\"Why is Weather Underground's Ad Free experience becoming a paid subscription?\",\"answer\":\"Weather Underground is dedicated to delivering the most accurate and hyperlocal weather forecasts available. To continue investing in the development and maintenance of our unique products, we've made the tough decision to transition our Ad Free experience to a paid subscription plan. We understand this change may not be ideal for everyone but we hope you'll consider subscribing to the Ad Free plan to support the service you know and love. We will still offer a robust free, ad-supported option with access to all of our core features.\"},{\"answer\":\"Users who don't operate an active Personal Weather Station and who are currently accessing an Ad Free experience at no cost will be moved to a free, ad-supported experience on March 5, 2024.\",\"question\":\"I've been accessing Ad Free at no cost. When am I no longer   eligible to do so?\"},{\"answer\":\"No. Weather Underground subscriptions are only valid on Weather Underground. A subscription with The Weather Channel is only valid on weather.com and The Weather Channel apps. While the same email address and password work across your account on both The Weather Channel and Weather Underground, subscriptions only work with the brand for which they were purchased.\",\"question\":\"If I purchase an Ad Free subscription on Weather Underground,   can I also use it to get an Ad Free experience on weather.com or   The Weather Channel apps for iOS or Android?\"},{\"answer\":\" We're sorry for the inconvenience but at this time, due to tax regulations, subscriptions are limited to users located in the United States. We are currently working on making international subscriptions available. You can still sign up for a free account and become a member of our Weather Underground community if you're located outside the United States.\",\"question\":\"I'm based outside the United States. Why can't I purchase an Ad   Free subscription?\"},{\"question\":\"Can I use my wunderground.com Ad Free subscription on the WU app for iOS or Android?\",\"answer\":\"No. As of right now, your Ad Free subscription is only for wunderground.com and will not allow you to get Premium access on either the WU iOS or Android app (and vice versa). A Premium subscription for the WU iOS or Android app offers additional features beyond no ads, including Smart Forecasts for planning outdoor activities and Extended Hourly Forecasts up to 15 days in the future.\"},{\"answer\":\"No. As of right now, your Ad Free subscription will not allow you to get Premium access on either the WU iOS or Android app (and vice versa). Currently we only offer Ad Free on wunderground.com. WU iOS and Android apps have additional premium features that are not available across platforms.\",\"question\":\"Can I use my Premium subscription on the WU iOS or Android app   on wunderground.com?\"},{\"answer\":\"When you click an article or video on wunderground.com, you may be taken to weather.com to view it. If you don't have a separate Ad Free subscription with The Weather Channel, this means you'll still see ads on content on weather.com.\",\"question\":\"I've purchased an Ad Free subscription. Why do I still see ads   on videos offered on the front page of wunderground.com?\"},{\"question\":\"If I switch from monthly to annual will the money I paid for the   monthly subscription be prorated for my annual purchase?\",\"answer\":\"Yes. All upgrades are prorated.\"}]},{\"title\":\"Personal Weather Stations and Ad Free Subscriptions\",\"content\":[{\"answer\":\"We understand that it might be surprising to see ads after previously enjoying an Ad Free experience. To make sure we keep providing the most accurate and valuable weather data to our users, we've updated our policy. Ad Free now depends on your Personal Weather Station remaining active. This means the Personal Weather Station has sent us data within the last 30 days. If you have a Personal Weather Station but it's been inactive for 30 days or more, you'll see ads on wunderground.com.\",\"question\":\"Why am I seeing ads, even though I have a Personal Weather Station?\"},{\"question\":\"How can I go back to not seeing ads?\",\"answer\":\"You have two options to regain an access to the Ad Free experience: <ol><li>Bring your Personal Weather Station back online - We understand technical issues can sometimes arise. Our support resources can help you troubleshoot common problems and get your Personal Weather Station sending us data again, at which point you'll automatically regain access to Ad Free.</li><li>Upgrade to a paid subscription - If you\u2019re not planning to send PWS data to us but would still like to enjoy an Ad Free experience, we offer both a monthly and an annual Ad Free subscription plan that zaps the ads and offers additional benefits like extended forecasts and exclusive features.</li></ol>\"},{\"answer\":\"When your Personal Weather Station starts sending data to Weather Underground again, your access to Ad Free will be reinstated, but you need to log out of wunderground.com and log back in to start seeing the website without ads.\u00A0\",\"question\":\"If I bring my Personal Weather Station back online, will my access to Ad Free return automatically?\"},{\"answer\":\" If your Personal Weather Station was registered with us prior to August 2023 and has uploaded data to our network in the last 30 days, Ad Free is available to you at no charge in exchange for the data you contribute. Log out of wunderground.com and log back in to activate your Ad Free experience.\",\"question\":\"I already have an active Personal Weather Station. Shouldn\u2019t I be seeing wunderground.com without ads?\"},{\"answer\":\"Of course! We offer a robust free, ad-supported version of Weather Underground with access to all core features, including weather forecasts, maps, and alerts. You can continue using Weather Underground for free while seeing occasional ads. We appreciate your understanding and continued support.\",\"question\":\"I don't plan to bring my Personal Weather Station back online. Can I still use wunderground.com for free?\"}]}]}},\"id\":\"cac4f5e2-c01e-4c21-9654-e44efd4ca0df\",\"relationships\":{\"locale\":{\"data\":null},\"twc_config_type\":{\"data\":null}},\"type\":\"state_config\"}},{\"_id\":\"3f7db82b-3ad6-4172-bf96-804c24ed4c47\",\"data\":{\"attributes\":{\"active\":false,\"environment\":null,\"name\":\"Experiments (Growthbook)\",\"value\":{\"morning-brief-signup__2\":[\"hourly\"],\"morning-brief-signup__1\":[\"hourly\"]}},\"id\":\"3f7db82b-3ad6-4172-bf96-804c24ed4c47\",\"relationships\":{\"locale\":{\"data\":{\"meta\":{\"drupal_internal__target_id\":2955},\"type\":\"locale\",\"id\":\"25b624ab-95a6-45ec-9dee-6abc917e53f3\"}},\"twc_config_type\":{\"data\":null}},\"type\":\"state_config\"}},{\"_id\":\"f33a3445-ea5d-4c5d-953c-2a0a63ff8edb\",\"data\":{\"attributes\":{\"active\":false,\"environment\":null,\"name\":\"TrademarkRegistration\",\"value\":{\"countryCodesWithoutRegisteredTrademark\":[\"VA\",\"SO\"]}},\"id\":\"f33a3445-ea5d-4c5d-953c-2a0a63ff8edb\"