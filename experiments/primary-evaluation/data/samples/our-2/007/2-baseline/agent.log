5T14:18:21.000Z\",\"location\":\"$undefined\"}}},\"coreMetadata\":{\"providerData\":{\"provider\":{\"name\":\"weather.com\",\"slug\":\"weathercom\",\"providerType\":\"internal\",\"isActive\":true,\"distributionAllowed\":true,\"distributionRules\":{\"blockedChannels\":[],\"channelDelays\":[],\"blockedTerritories\":[]},\"createdBy\":\"twcwx.cmssvc@weather.com\",\"updatedBy\":\"Shaun.Wallace@weather.com\",\"id\":\"68fa815dc0978346abe11f90\"},\"distributionOverride\":{\"customDelays\":[]}}},\"prefix\":\"wxnext/img\",\"url\":\"https://s.w-x.co/wxnext/img/indy-500-051626\",\"filename\":\"indy-500-051626\",\"mimeType\":\"image/jpeg\",\"filesize\":104402,\"width\":1024,\"height\":683,\"focalX\":50,\"focalY\":50,\"sizes\":{\"small\":{\"url\":\"https://s.w-x.co/wxnext/img/indy-500-051626-900x300.jpg\",\"width\":900,\"height\":300,\"mimeType\":\"image/jpeg\",\"filesize\":35882,\"filename\":\"indy-500-051626-900x300.jpg\"},\"large\":{\"url\":\"https://s.w-x.co/wxnext/img/indy-500-051626-1800x600.jpg\",\"width\":1800,\"height\":600,\"mimeType\":\"image/jpeg\",\"filesize\":93103,\"filename\":\"indy-500-051626-1800x600.jpg\"}},\"thumbnailURL\":null,\"id\":\"6a088d27953f490ad144517d\"},\"blockType\":\"Image\"}},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The first round of qualifying for the 110th Indianapolis 500 was rained out Saturday, leading to a busy, condensed schedule on Sunday.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Storms and showers rained out practice on Saturday morning and kept coming into the afternoon, forcing IndyCar to push all qualifying to Sunday.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"type\":\"block\",\"version\":2,\"format\":\"\",\"fields\":{\"id\":\"6a088abac65df40d71a2ad31\",\"tweetId\":null,\"tweetURL\":\"https://twitter.com/IndyCar/status/2055735182292828440\",\"metricsId\":\"6a088abac65df40d71a2ad31\",\"blockName\":\"\",\"showThread\":false,\"entryMethod\":\"url\",\"blockType\":\"Twitter\"}},{\"children\":[],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Qualifying will begin at noon on Sunday, and each driver will only get one try at qualifying for the Fast 12 and a second qualifying session. More on this procedure can be found \",\"type\":\"text\",\"version\":1},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"here\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"link\",\"version\":3,\"fields\":{\"url\":\"https://www.indycar.com/-/media/Files/2026/NICS/07-500/indycar-QualDraw-Sat-26I500.pdf\",\"linkType\":\"custom\"},\"id\":\"6a0893fb836433822408df39\"},{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\". \",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"Fortunately for IndyCar, Sunday's activities at Indianapolis Motor Speedway won't be rained out. Forecasters are calling for a dry, warm and mostly sunny day on Sunday.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"},{\"type\":\"block\",\"version\":2,\"format\":\"\",\"fields\":{\"id\":\"6a09bee5781dda6a188b91c4\",\"imageType\":\"internal\",\"metricsId\":\"6a09bee5781dda6a188b91c4\",\"blockName\":\"\",\"controls\":{\"width\":\"full\",\"alignment\":\"center\",\"showCaption\":true,\"useImageCaption\":true},\"isPriorityImage\":false,\"internalImageId\":{\"createdAt\":\"2026-05-17T13:13:41.056Z\",\"updatedAt\":\"2026-05-17T13:13:41.192Z\",\"tenant\":\"$3c:1:props:children:0:props:children:props:children:0:props:children:1:props:children:props:globalPageProps:article:content:body:root:children:0:fields:internalImageId:tenant\",\"name\":\"0517 INdy Snap\",\"isAnimated\":false,\"seo\":{\"altText\":\"Indianapolis forecast\",\"schema\":{\"representativeOfPage\":false,\"exifData\":{\"location\":\"$undefined\"}}},\"coreMetadata\":{\"providerData\":{\"provider\":\"$3c:1:props:children:0:props:children:props:children:0:props:children:1:props:children:props:globalPageProps:article:content:body:root:children:0:fields:internalImageId:coreMetadata:providerData:provider\",\"distributionOverride\":{\"customDelays\":[]}}},\"prefix\":\"wxnext/img\",\"url\":\"https://s.w-x.co/wxnext/img/0517_INdy_Snap-f2f40c.png\",\"filename\":\"0517_INdy_Snap-f2f40c.png\",\"mimeType\":\"image/png\",\"filesize\":87063,\"width\":1920,\"height\":1080,\"focalX\":50,\"focalY\":50,\"sizes\":{\"small\":{\"url\":\"https://s.w-x.co/wxnext/img/0517_INdy_Snap-f2f40c-900x300.png\",\"width\":900,\"height\":300,\"mimeType\":\"image/png\",\"filesize\":44150,\"filename\":\"0517_INdy_Snap-f2f40c-900x300.png\"},\"large\":{\"url\":\"https://s.w-x.co/wxnext/img/0517_INdy_Snap-f2f40c-1800x600.png\",\"width\":1800,\"height\":600,\"mimeType\":\"image/png\",\"filesize\":124024,\"filename\":\"0517_INdy_Snap-f2f40c-1800x600.png\"}},\"thumbnailURL\":null,\"id\":\"6a09bf05705749640ff24666\"},\"blockType\":\"Image\"}},{\"children\":[{\"detail\":0,\"format\":0,\"mode\":\"normal\",\"style\":\"\",\"text\":\"The green flag will drop on the iconic race at 12:45 p.m. on May 24.\",\"type\":\"text\",\"version\":1}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"paragraph\",\"version\":1,\"textFormat\":0,\"textStyle\":\"\"}],\"direction\":null,\"format\":\"\",\"indent\":0,\"type\":\"root\",\"version\":1}}},\"seo\":{\"title\":\"Rain Delays Qualifying At The Indy 500\",\"description\":\"Qualifying at the Indianapolis 500 is delayed Saturday due to heavy rain. It could get pushed back to Sunday.\",\"image\":\"$3c:1:props:children:0:props:children:props:children:0:props:children:1:props:children:props:globalPageProps:article:content:body:root:children:0:fields:internalImageId\",\"keywords\":null,\"schema\":{\"articleSection\":\"News / Weather\",\"wordCount\":121}},\"coreMetadata\":{\"entitlements\":[\"platform-all-free\",\"platform-all-standard\",\"platform-all-premium\"],\"adMetric\":{\"name\":\"weather/news\",\"slug\":\"weather-news\",\"type\":\"adMetrics\",\"pathSegments\":[],\"parent\":[{\"name\":\"news\",\"slug\":\"news\",\"type\":\"adZones\",\"pathSegments\":[],\"id\":\"692f4db48ad6e807e0414d0d\"}],\"id\":\"692f504f19a2aa561b68c3c3\"},\"adMetricLock\":true,\"providerData\":{\"provider\":{\"name\":\"weather.com\",\"slug\":\"weathercom\",\"providerType\":\"internal\",\"isActive\":true,\"distributionAllowed\":true,\"distributionRules\":{\"blockedChannels\":[],\"channelDelays\":[],\"blockedTerritories\":[]},\"createdBy\":\"twcwx.cmssvc@weather.com\",\"updatedBy\":\"Shaun.Wallace@weather.com\",\"id\":\"68fa815dc0978346abe11f90\"},\"distributionOverride\":{\"customDelays\":[]}},\"providerType\":\"internal\",\"createdBy\":\"mark.smith@weather.com\",\"updatedBy\":\"ada.wood@weather.com\"},\"channelOverrides\":{\"channelHeadlines\":[],\"channelImages\":[]},\"assetName\":\"/2026/05/16/news/weather/rain-delays-qualifying-for-the-indy-500\",\"assetNameLock\":true,\"publishDate\":\"2026-05-16T14:19:01.298Z\",\"publishDateLock\":true,\"slug\":\"rain-delays-qualifying-for-the-indy-500\",\"slugLock\":true,\"_status\":\"published\",\"_embedding\":[0.0055336495861411095,-0.015230705961585045,-0.00