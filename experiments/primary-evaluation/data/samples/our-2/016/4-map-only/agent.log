<div id="image-panels-top" style="margin: 0 0 16px 0;">
  <style>
    /* Move image panels to top using order */
    #b_results {
      display: flex !important;
      flex-direction: column !important;
    }
    #b_results > li.b_ans.b_imgansacf,
    #b_results > li.b_ans.b_imgexpansacf-cloned {
      order: -999 !important;
    }

    /* Hide the aside sidebar "Explore with images" since we clone it inline */
    aside[aria-label="Additional Results"] .b_imgexpansacf {
      display: none !important;
    }

    /* Larger image thumbnails in both panels */
    #b_results li.b_ans.b_imgansacf .iacfmit,
    #b_results li.b_ans.b_imgexpansacf-cloned .iacfmit {
      height: 180px !important;
    }
    #b_results li.b_ans.b_imgansacf .iacf_plan {
      height: 450px !important;
    }
    #b_results li.b_ans.b_imgansacf .mimg img,
    #b_results li.b_ans.b_imgansacf .iacfimgc img,
    #b_results li.b_ans.b_imgansacf .cico img {
      width: 100% !important;
      height: 160px !important;
      object-fit: cover !important;
    }

    /* Larger thumbnails for Explore with images */
    #b_results li.b_ans.b_imgexpansacf-cloned .iacfmit {
      height: 200px !important;
    }
    #b_results li.b_ans.b_imgexpansacf-cloned .cico img,
    #b_results li.b_ans.b_imgexpansacf-cloned .iacfimgc img {
      width: 100% !important;
      height: 170px !important;
      object-fit: cover !important;
    }

    /* Smaller textual snippets in search results */
    #b_results .b_algo p.b_lineclamp2,
    #b_results .b_algo .b_caption p {
      font-size: 12px !important;
      line-height: 16px !important;
    }
    #b_results .b_algo .tptt {
      font-size: 12px !important;
    }
    #b_results .b_algo cite {
      font-size: 11px !important;
    }

    /* Image panel headers - larger */
    #b_results li.b_ans.b_imgansacf .iaheader a.iacf_head span,
    #b_results li.b_ans.b_imgexpansacf-cloned .iaheader a.iacf_head span {
      font-size: 18px !important;
      font-weight: 700 !important;
    }

    /* Make image panels full-width */
    #b_results li.b_ans.b_imgansacf,
    #b_results li.b_ans.b_imgexpansacf-cloned {
      width: 100% !important;
      margin-bottom: 16px !important;
    }

    /* Smaller text in image panel labels */
    #b_results li.b_ans .iacf_info a,
    #b_results li.b_ans .imgInfo {
      font-size: 12px !important;
    }
  </style>
  <script>
    (function() {
      // Clone "Explore with images" panel from sidebar into main results
      var explorePanel = document.querySelector('aside[aria-label="Additional Results"] .b_imgexpansacf');
      if (explorePanel) {
        var clone = explorePanel.cloneNode(true);
        clone.classList.add('b_imgexpansacf-cloned');
        clone.removeAttribute('data-bm');
        // Remove elementtiming div from clone
        var timingDiv = clone.querySelector('[elementtiming]');
        if (timingDiv) timingDiv.remove();
        
        // Insert after Images of Cats panel
        var imagesPanel = document.querySelector('#b_results > li.b_ans.b_imgansacf');
        if (imagesPanel && imagesPanel.nextSibling) {
          imagesPanel.parentNode.insertBefore(clone, imagesPanel.nextSibling);
        } else if (imagesPanel) {
          imagesPanel.parentNode.appendChild(clone);
        }
      }
    })();
  </script>
</div>


