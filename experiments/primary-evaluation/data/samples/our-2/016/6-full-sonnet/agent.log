if (currentHeight && !element.dataset.enlarged) {
  element.style.height = (currentHeight * 1.8) + 'px';
  element.dataset.enlarged = '1';
  items.forEach(item => {
    const top = parseFloat(item.style.top);
    const height = parseFloat(item.style.height);
    const left = item.style.left;
    const width = item.style.width;
    if (!item.dataset.enlarged) {
      item.style.height = (height * 1.8) + 'px';
      if (top > 0) item.style.top = (top * 1.8) + 'px';
      item.dataset.enlarged = '1';
    }
  });
}

