    // Add "Shorts only" chip after "Unwatched" (the 2nd chip)
if (element.getAttribute('data-shorts-chip-added') === 'true') return;

const chips = Array.from(element.querySelectorAll('yt-chip-cloud-chip-renderer'));
if (chips.length < 2) return;

// Check if already added
for (let i = 0; i < chips.length; i++) {
  const textDiv = chips[i].querySelector('button > .ytChipShapeChip > div');
  if (textDiv && textDiv.textContent.trim() === 'Shorts only') return;
}

const unwatchedChip = chips[1]; // "Unwatched" is the 2nd chip

const newChip = document.createElement('yt-chip-cloud-chip-renderer');
newChip.setAttribute('chip-style', 'STYLE_HOME_FILTER');

const container = document.createElement('div');
container.id = 'chip-shape-container';

const chipShape = document.createElement('chip-shape');
chipShape.setAttribute('class', 'ytChipShapeHost');

const button = document.createElement('button');
button.setAttribute('class', 'ytChipShapeButtonReset');
button.setAttribute('role', 'tab');
button.setAttribute('aria-selected', 'false');

const chipDiv = document.createElement('div');
chipDiv.setAttribute('class', 'ytChipShapeChip ytChipShapeInactive ytChipShapeOnlyTextPadding');

const textDiv = document.createElement('div');
textDiv.textContent = 'Shorts only';

chipDiv.appendChild(textDiv);
button.appendChild(chipDiv);
chipShape.appendChild(button);
container.appendChild(chipShape);
newChip.appendChild(container);

element.insertBefore(newChip, unwatchedChip.nextSibling);
element.setAttribute('data-shorts-chip-added', 'true');

// Click handler for Shorts only chip
button.addEventListener('click', function() {
  var allChips = element.querySelectorAll('yt-chip-cloud-chip-renderer');
  var gridShelves = document.querySelectorAll('grid-shelf-view-model.ytGridShelfViewModelHost');
  var otherContent = document.querySelectorAll('ytd-video-renderer, ytd-search-pyv-renderer, ytd-shelf-renderer.ytd-item-section-renderer, ytd-horizontal-card-list-renderer');

  // Deactivate all chips
  for (var i = 0; i < allChips.length; i++) {
    allChips[i].classList.remove('iron-selected');
    var b = allChips[i].querySelector('button');
    if (b) b.setAttribute('aria-selected', 'false');
    var cd = allChips[i].querySelector('.ytChipShapeChip');
    if (cd) {
      cd.classList.remove('ytChipShapeActive');
      cd.classList.add('ytChipShapeInactive');
    }
  }

  // Activate Shorts only chip
  newChip.classList.add('iron-selected');
  button.setAttribute('aria-selected', 'true');
  var activeDiv = newChip.querySelector('.ytChipShapeChip');
  if (activeDiv) {
    activeDiv.classList.remove('ytChipShapeInactive');
    activeDiv.classList.add('ytChipShapeActive');
  }

  // Hide non-Shorts content
  for (var j = 0; j < otherContent.length; j++) {
    otherContent[j].style.display = 'none';
  }
  for (var k = 0; k < gridShelves.length; k++) {
    gridShelves[k].style.display = '';
  }
}, true);

// Also update existing chips to restore normal view when clicked
for (var m = 0; m < allChips.length; m++) {
  if (allChips[m] === newChip) continue;
  var existingBtn = allChips[m].querySelector('button');
  if (!existingBtn) continue;
  existingBtn.addEventListener('click', function() {
    var otherContent2 = document.querySelectorAll('ytd-video-renderer, ytd-search-pyv-renderer, ytd-shelf-renderer.ytd-item-section-renderer, ytd-horizontal-card-list-renderer');
    var gridShelves2 = document.querySelectorAll('grid-shelf-view-model.ytGridShelfViewModelHost');
    for (var p = 0; p < otherContent2.length; p++) {
      otherContent2[p].style.display = '';
    }
    for (var q = 0; q < gridShelves2.length; q++) {
      gridShelves2[q].style.display = '';
    }
  }, true);
}

