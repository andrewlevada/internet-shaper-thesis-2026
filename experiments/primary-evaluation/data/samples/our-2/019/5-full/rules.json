    "logic": "element.style.height = '40px';"
  },
  {
    "label": "Remove extra header spacer",
    "query_selector": "header > div[style*=\"height:80px\"]:not([data-test-id])",
    "logic": "element.style.height = '20px';"
  },
  {
    "label": "Shrink search bar height",
    "query_selector": "#searchBoxContainer > div[style*=\"height:48px\"]",
    "logic": "element.style.height = '28px';"
  },
  {
    "label": "Shrink header logo/tab area",
    "query_selector": "[data-test-id=\"ideas-tab\"][style*=\"height:48px\"]",
