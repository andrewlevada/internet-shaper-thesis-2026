[
  {
    "label": "Shrink header container",
    "query_selector": "header.ADXRXN > div[data-test-id=\"unauth-header\"] > div[style*=\"height:80px\"]",
    "logic": "element.style.height = '44px';"
  },
  {
    "label": "Shrink search bar height",
    "query_selector": "div[data-test-id=\"search-box-container\"] div[style*=\"height:48px\"]",
    "logic": "element.style.height = '32px';"
  },
  {
    "label": "Shrink header spacer",
    "query_selector": "header.ADXRXN > div[style*=\"height:80px\"]",
    "logic": "element.style.height = '44px';"
  },
  {
    "label": "Shrink page title text",
    "query_selector": "h1.wyEmcc",
    "logic": "element.style.fontSize = '20px';\nelement.style.marginBottom = '8px';"
  },
  {
    "label": "Shrink section headers",
    "query_selector": "h2.wyEmcc",
    "logic": "element.style.fontSize = '16px';\nelement.style.marginBottom = '6px';"
  },
  {
    "label": "Shrink Explore tab height",
    "query_selector": "div[data-test-id=\"ideas-tab\"]",
    "logic": "element.style.height = '32px';"
  }
]
