[1] Add Save to Board button on pins — .PinCard__imageWrapper
    
// Idempotency: only inject once per card
if (element.querySelector('.ext-save-btn')) return;

// Ensure the wrapper is a positioning context
element.style.position = 'relative';

// --- Button ---
const btn = document.createElement('button');
btn.className = 'ext-save-btn';
btn.textContent = '＋ Save';

// Derive the pin URL from the closest anchor ancestor
const anchor = element.closest('[data-test-pin-id]');
const pinId = anchor ? anchor.getAttribute('data-test-pin-id') : null;
if (pinId) {
  btn.setAttribute('data-pin-id', pinId);
}

// Styling: always-visible pill in the top-right corner of the thumbnail
btn.style.cssText = [
  'position: absolute',
  'top: 10px',
  'right: 10px',
  'z-index: 99',
  'display: flex',
  'align-items: center',
  'gap: 4px',
  'padding: 8px 14px',
  'background: #e60023',           // Pinterest red
  'color: #fff',
  'font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
  'font-size: 13px',
  'font-weight: 700',
  'line-height: 1',
  'border: none',
  'border-radius: 24px',
  'cursor: pointer',
  'box-shadow: 0 2px 8px rgba(0,0,0,0.35)',
  'letter-spacing: 0.2px',
  'transition: background 0.15s, transform 0.1s',
  'pointer-events: auto',
  'white-space: nowrap',
  'user-select: none'
].join('; ');

// Hover / active feedback
btn.addEventListener('mouseenter', () => {
  btn.style.background = '#ad081b';
  btn.style.transform = 'scale(1.05)';
});
btn.addEventListener('mouseleave', () => {
  btn.style.background = '#e60023';
  btn.style.transform = 'scale(1)';
});
btn.addEventListener('mousedown', () => { btn.style.transform = 'scale(0.96)'; });
btn.addEventListener('mouseup',   () => { btn.style.transform = 'scale(1.05)'; });

// Click handler: navigate to the pin's save flow, or show a toast
btn.addEventListener('click', (e) => {
  e.preventDefault();
  e.stopPropagation();

  const pid = btn.getAttribute('data-pin-id');
  const saveUrl = pid ? `https://www.pinterest.com/pin/${pid}/save/` : null;

  // Visual feedback: change label temporarily
  const original = btn.textContent;
  btn.textContent = '✓ Saved!';
  btn.style.background = '#00875a';
  setTimeout(() => {
    btn.textContent = original;
    btn.style.background = '#e60023';
  }, 2000);

  // Open the Pinterest save/board-picker dialog in a new tab
  if (saveUrl) {
    window.open(saveUrl, '_blank', 'noopener');
  }
});

element.appendChild(btn);


