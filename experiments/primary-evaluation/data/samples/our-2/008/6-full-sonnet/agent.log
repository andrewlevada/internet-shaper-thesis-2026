t saveUrl = pid ? `https://www.pinterest.com/pin/${pid}/save/` : null;\n\n  // Visual feedback: change label temporarily\n  const original = btn.textContent;\n  btn.textContent = '✓ Saved!';\n  btn.style.background = '#00875a';\n  setTimeout(() => {\n    btn.textContent = original;\n    btn.style.background = '#e60023';\n  }, 2000);\n\n  // Open the Pinterest save/board-picker dialog in a new tab\n  if (saveUrl) {\n    window.open(saveUrl, '_blank', 'noopener');\n  }\n});\n\nelement.appendChild(btn);\n"
