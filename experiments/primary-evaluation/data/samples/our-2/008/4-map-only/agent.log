(function() {
  function addSaveButtons() {
    var pins = document.querySelectorAll('.PinCard__imageWrapper');
    pins.forEach(function(wrapper) {
      if (wrapper.querySelector('.custom-save-btn')) return;
      var btn = document.createElement('button');
      btn.className = 'custom-save-btn';
      btn.setAttribute('aria-label', 'Save to Board');
      btn.setAttribute('type', 'button');
      btn.innerHTML = '<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18.75 2H5.25A3.25 3.25 0 0 2 2 5.25v15.5A3.25 3.25 0 0 2 5.25 24h13.5A3.25 3.25 0 0 2 22 20.75V5.25A3.25 3.25 0 0 2 18.75 2zM12 17.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10z"/></svg> Save to Board';
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var pinId = wrapper.closest('[data-test-pin-id]');
        if (pinId) {
          var id = pinId.getAttribute('data-test-pin-id');
          window.open('https://www.pinterest.com/pin/' + id + '/action/save/', '_blank');
        }
      });
      wrapper.style.position = 'relative';
      wrapper.appendChild(btn);
    });
  }

  // Initial run after DOM settles
  setTimeout(addSaveButtons, 500);
  setTimeout(addSaveButtons, 1500);

  // Observe for new pins loaded via scroll
  var observer = new MutationObserver(function() {
    addSaveButtons();
  });
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
