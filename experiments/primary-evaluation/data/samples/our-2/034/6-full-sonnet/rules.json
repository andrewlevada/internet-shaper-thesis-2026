[
	{
		"label": "Remove collapsed state from AI card",
		"query_selector": ".FuturisSearchCard_view_fold",
		"logic": "element.classList.remove('FuturisSearchCard_collapsed');"
	},
	{
		"label": "Remove FactFold height-limited class",
		"query_selector": ".FactFold.FactFold_height-limited",
		"logic": "element.classList.remove('FactFold_height-limited');"
	},
	{
		"label": "Remove FactFold container height cap",
		"query_selector": ".FactFold-Container",
		"logic": "element.style.height = 'auto'; element.style.overflow = 'visible';"
	},
	{
		"label": "Hide \"show more\" button wrapper",
		"query_selector": ".FactFold-Wrapper",
		"logic": "element.style.display = 'none';"
	},
	{
		"label": "Hide folded divider",
		"query_selector": ".FactFold-Divider_folded",
		"logic": "element.style.display = 'none';"
	}
]
