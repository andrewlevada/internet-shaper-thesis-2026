[
  {
    "label": "Expand Alice AI card",
    "query_selector": ".FuturisSearchCard_collapsed",
    "logic": "element.classList.remove('FuturisSearchCard_collapsed');\nelement.classList.add('FuturisSearchCard_expanded');"
  },
  {
    "label": "Remove AI card height limit",
    "query_selector": ".FactFold_height-limited",
    "logic": "element.classList.remove('FactFold_height-limited');"
  },
  {
    "label": "Unfold AI card container",
    "query_selector": ".FactFold-Container",
    "logic": "element.style.height = '';\nelement.style.maxHeight = 'none';"
  },
  {
    "label": "Hide AI show more button",
    "query_selector": ".FactFold-Wrapper",
    "logic": "element.style.display = 'none';"
  },
  {
    "label": "Hide AI card folded divider",
    "query_selector": ".FactFold-Divider_folded",
    "logic": "element.style.display = 'none';"
  }
]
