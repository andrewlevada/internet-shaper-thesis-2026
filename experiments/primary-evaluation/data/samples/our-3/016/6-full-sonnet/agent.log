const commentsSection = element.querySelector('#comments-section');
const articleHeader = element.querySelector('[data-testid="article-header"]');
const articleBody = element.querySelector('.flatplan_body');

if (!commentsSection || !articleHeader || !articleBody) return;

// Check if already repositioned to avoid duplicate moves
if (articleHeader.nextElementSibling === commentsSection) return;

// Style the comments section for its new prominent position
commentsSection.style.marginTop = '0';
commentsSection.style.borderTop = 'none';
commentsSection.style.paddingTop = '0';
commentsSection.style.marginBottom = '24px';
commentsSection.style.background = '#f8fafc';
commentsSection.style.borderRadius = '12px';
commentsSection.style.padding = '20px';
commentsSection.style.border = '1px solid #e2e8f0';

// Add a label above the section
let label = commentsSection.querySelector('#community-label');
if (!label) {
  label = document.createElement('p');
  label.id = 'community-label';
  label.textContent = '💬 Community Reactions & Comments';
  label.style.fontSize = '14px';
  label.style.fontWeight = '700';
  label.style.color = '#374151';
  label.style.marginBottom = '12px';
  label.style.marginTop = '0';
  label.style.textTransform = 'uppercase';
  label.style.letterSpacing = '0.05em';
  commentsSection.insertBefore(label, commentsSection.firstChild);
}

// Insert the comments section right after the article header
articleHeader.insertAdjacentElement('afterend', commentsSection);


