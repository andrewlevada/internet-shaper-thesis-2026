{
  "rules": [
    {
      "label": "Hide sidebar sign-in promo",
      "query_selector": "ytd-guide-signin-promo-renderer",
      "logic": "element.style.display = 'none'"
    },
    {
      "label": "Hide header sign-in button",
      "query_selector": "ytd-masthead #buttons ytd-button-renderer[button-renderer] a[href*=\"accounts.google.com\"]",
      "logic": "const parentButtonRenderer = element.closest('ytd-button-renderer');\nif (parentButtonRenderer) {\n  parentButtonRenderer.style.display = 'none';\n}"
    }
  ],
  "result": {
    "success": true,
    "log": "rules applied in real-time"
  }
}
