const pinEl = element.closest('[data-test-id="pin"]');
const pinId = pinEl ? pinEl.getAttribute('data-test-pin-id') : null;
const anchor = pinEl ? pinEl.querySelector('a[href*="/pin/"]') : null;
const href = anchor ? anchor.getAttribute('href') : '#';

// Create the button
const btn = document.createElement('a');
btn.className = 'ext-save-btn';
btn.href = href;
btn.target = '_blank';
btn.rel = 'noopener noreferrer';
btn.textContent = '⬆ Save';
btn.title = 'Save this Pin to a board';

// Prevent click from bubbling to the pin card link
btn.addEventListener('click', function(e) {
  e.stopPropagation();
});

