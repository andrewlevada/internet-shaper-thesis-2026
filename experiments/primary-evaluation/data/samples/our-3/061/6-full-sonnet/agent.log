// Language and region keywords to match against tag labels
const LANG_REGION_KEYWORDS = [
  // Languages
  'english','spanish','french','german','portuguese','italian','russian','japanese',
  'korean','chinese','arabic','hindi','turkish','polish','dutch','swedish','norwegian',
  'danish','finnish','czech','hungarian','romanian','greek','thai','vietnamese',
  'indonesian','malay','tagalog','ukrainian','catalan','hebrew','persian','farsi',
  'bengali','tamil','telugu','urdu','punjabi','marathi','gujarati','kannada',
  'serbian','croatian','slovak','bulgarian','slovenian','latvian','lithuanian',
  'estonian','icelandic', 'azerbaijani', 'georgian', 'armenian', 'kazakh',
  // Regional / locale labels
  'latam','latin america','brasil','brazil','uk','us','usa','eu','europe',
  'asia','mena','oceania','africa','north america','south america','middle east',
  'australia','new zealand','canada','mexico','philippines','india','japan','korea',
  'taiwan','hong kong','singapore','malaysia','indonesia','thailand','vietnam',
  // Common Twitch language tags
  'asl','sign language'
];

function isLangRegion(tagLabel) {
  const lower = tagLabel.toLowerCase().trim();
  return LANG_REGION_KEYWORDS.some(kw => lower === kw || lower.startsWith(kw + ' ') || lower.endsWith(' ' + kw));
}

// Idempotency: use a data attribute to track the injected banner
const MARKER = 'data-lang-tags-injected';

// Find all tag <a> elements inside this card
const tagAnchors = element.querySelectorAll('.tw-tag[aria-label]');
if (!tagAnchors.length) return;

// Collect matching language/regional tags
const langTags = [];
tagAnchors.forEach(tag => {
  const label = tag.getAttribute('aria-label') || '';
  // aria-label is like "Tag, English"
  const tagName = label.replace(/^Tag,\s*/i, '').trim();
  if (isLangRegion(tagName)) {
    langTags.push({ anchor: tag, name: tagName });
  }
});

if (!langTags.length) {
  // No language tags — remove any previously injected banner
  const old = element.querySelector('.lang-tag-banner');
  if (old) old.remove();
  return;
}

// Build or replace the banner
let banner = element.querySelector('.lang-tag-banner');
if (!banner) {
  banner = document.createElement('div');
  banner.className = 'lang-tag-banner';
  banner.style.cssText = [
    'display:flex',
    'flex-wrap:wrap',
    'align-items:center',
    'gap:4px',
    'padding:5px 0 4px 0',
    'margin-bottom:4px',
    'border-bottom:1px solid rgba(145,71,255,0.25)',
  ].join(';');
  // Insert as the very first child of the text wrapper
  element.insertBefore(banner, element.firstChild);
}

// Rebuild banner contents each time (idempotent)
banner.textContent = '';

// Small globe icon label
const label = document.createElement('span');
label.textContent = '🌐';
label.style.cssText = 'font-size:13px;line-height:1;flex-shrink:0;';
banner.appendChild(label);

langTags.forEach(({ anchor, name }) => {
  const pill = document.createElement('a');
  pill.href = anchor.href || '#';
  pill.textContent = name;
  pill.title = name;
  pill.style.cssText = [
    'display:inline-flex',
    'align-items:center',
    'padding:2px 8px',
    'border-radius:9999px',
    'font-size:11px',
    'font-weight:700',
    'line-height:1.6',
    'letter-spacing:0.03em',
    'text-decoration:none',
    'cursor:pointer',
    'background:linear-gradient(135deg,#9147ff 0%,#6441a5 100%)',
    'color:#fff',
    'border:1.5px solid rgba(255,255,255,0.18)',
    'box-shadow:0 1px 4px rgba(100,65,165,0.35)',
    'transition:filter 0.15s',
    'flex-shrink:0',
  ].join(';');
  pill.addEventListener('mouseenter', () => { pill.style.filter = 'brightness(1.15)'; });
  pill.addEventListener('mouseleave', () => { pill.style.filter = ''; });
  banner.appendChild(pill);
});


