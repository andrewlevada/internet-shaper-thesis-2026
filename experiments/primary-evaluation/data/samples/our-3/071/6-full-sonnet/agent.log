// --- Idempotency guard ---
if (element.querySelector('#recommended-self-help-block')) return;

// --- Collect links from sidebar ---
const sidebarLinks = [];
document.querySelectorAll('.collapsible-sidebar-body a.sidenav-item').forEach(a => {
  if (!a.classList.contains('current-article')) {
    sidebarLinks.push({ href: a.href, text: a.textContent.trim() });
  }
});

// --- Collect links from related articles ---
const relatedLinks = [];
document.querySelectorAll('.related-articles ul li a').forEach(a => {
  relatedLinks.push({ href: a.href, text: a.textContent.trim() });
});

// --- Merge, deduplicate by text ---
const seen = new Set();
const allLinks = [];
[...sidebarLinks, ...relatedLinks].forEach(link => {
  if (!seen.has(link.text)) {
    seen.add(link.text);
    allLinks.push(link);
  }
});

if (allLinks.length === 0) return;

// --- Build the block ---
