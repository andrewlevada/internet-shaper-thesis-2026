  "logic": "\n// --- Idempotency guard ---\nif (element.querySelector('#recommended-self-help-block')) return;\n\n// --- Collect links from sidebar ---\nconst sidebarLinks = [];\ndocument.querySelectorAll('.collapsible-sidebar-body a.sidenav-item').forEach(a => {\n  if (!a.classList.contains('current-article')) {\n    sidebarLinks.push({ href: a.href, text: a.textContent.trim() });\n  }\n});\n\n// --- Collect links from related articles ---\nconst relatedLinks = [];\ndocument.querySelectorAll('.related-articles ul li a').forEach(a => {\n  relatedLinks.push({ href: a.href, text: a.textContent.trim() });\n});\n\n// --- Merge, deduplicate by text ---\nconst seen = new Set();\nconst allLinks = [];\n[...sidebarLinks, ...relatedLinks].forEach(link => {\n  if (!seen.has(link.text)) {\n    seen.add(link.text);\n    allLinks.push(link);\n  }\n});\n\nif (allLinks.length === 0) return;\n\n// --- Build the block ---\nconst block = document.createElement('div');\nblock.id = 'recommended-self-help-block';\nblock.style.cssText = [\n  'margin: 0 0 28px 0',\n  'padding: 20px 24px 18px 24px',\n  'background: linear-gradient(135deg, #f0f7ff 0%, #e8f4e8 100%)',\n  'border: 2px solid #4a90d9',\n  'border-radius: 10px',\n  'box-shadow: 0 3px 12px rgba(74,144,217,0.15)',\n  'font-family: inherit'\n].join(';');\n\n// Header row\nconst header = document.createElement('div');\nheader.style.cssText = 'display:flex;align-items:center;gap:10px;margin-bottom:14px;';\n\nconst icon = document.createElement('span');\nicon.textContent = '💡';\nicon.style.cssText = 'font-size:22px;line-height:1;';\n\nconst title = document.createElement('h2');\ntitle.textContent = 'Recommended Self-Help';\ntitle.style.cssText = [\n  'margin: 0',\n  'font-size: 16px',\n  'font-weight: 700',\n  'color: #1a3a5c',\n  'letter-spacing: 0.3px',\n  'text-transform: uppercase'\n].join(';');\n\nconst badge = document.createElement('span');\nbadge.textContent = allLinks.length + ' articles';\nbadge.style.cssText = [\n  'margin-left: auto',\n  'background: #4a90d9',\n  'color: #fff',\n  'font-size: 11px',\n  'font-weight: 600',\n  'padding: 2px 9px',\n  'border-radius: 20px',\n  'letter-spacing: 0.5px'\n].join(';');\n\nheader.appendChild(icon);\nheader.appendChild(title);\nheader.appendChild(badge);\nblock.appendChild(header);\n\n// Divider\nconst divider = document.createElement('hr');\ndivider.style.cssText = 'border:none;border-top:1px solid #c5ddf5;margin:0 0 14px 0;';\nblock.appendChild(divider);\n\n// Links grid\nconst grid = document.createElement('ul');\ngrid.style.cssText = [\n  'list-style: none',\n  'margin: 0',\n  'padding: 0',\n  'display: grid',\n  'grid-template-columns: repeat(auto-fill, minmax(230px, 1fr))',\n  'gap: 8px 16px'\n].join(';');\n\nallLinks.forEach(link => {\n  const li = document.createElement('li');\n  li.style.cssText = 'display:flex;align-items:flex-start;gap:7px;';\n\n  const bullet = document.createElement('span');\n  bullet.textContent = '→';\n  bullet.style.cssText = 'color:#4a90d9;font-weight:700;font-size:14px;margin-top:1px;flex-shrink:0;';\n\n  const a = document.createElement('a');\n  a.href = link.href;\n  a.textContent = link.text;\n  a.style.cssText = [\n    'color: #1a5fa8',\n    'font-size: 14px',\n    'font-weight: 500',\n    'text-decoration: none',\n    'line-height: 1.4',\n    'transition: color 0.15s'\n  ].join(';');\n  a.addEventListener('mouseover', () => { a.style.color = '#e85d04'; a.style.textDecoration = 'underline'; });\n  a.addEventListener('mouseout', () => { a.style.color = '#1a5fa8'; a.style.textDecoration = 'none'; });\n\n  li.appendChild(bullet);\n  li.appendChild(a);\n  grid.appendChild(li);\n});\n\nblock.appendChild(grid);\n\n// --- Insert after article header ---\nconst articleHeader = element.querySelector('header.article-header');\nif (articleHeader && articleHeader.nextSibling) {\n  element.insertBefore(block, articleHeader.nextSibling);\n} else if (articleHeader) {\n  element.appendChild(block);\n}\n\n// --- Hide origin