header.style.cssText = 'display:flex;align-items:center;gap:10px;margin-bottom:14px;';

const icon = document.createElement('span');
icon.textContent = '💡';
icon.style.cssText = 'font-size:22px;line-height:1;';

const title = document.createElement('h2');
title.textContent = 'Recommended Self-Help';
title.style.cssText = [
  'margin: 0',
  'font-size: 16px',
  'font-weight: 700',
  'color: #1a3a5c',
  'letter-spacing: 0.3px',
  'text-transform: uppercase'
].join(';');

const badge = document.createElement('span');
badge.textContent = allLinks.length + ' articles';
badge.style.cssText = [
  'margin-left: auto',
  'background: #4a90d9',
  'color: #fff',
  'font-size: 11px',
  'font-weight: 600',
  'padding: 2px 9px',
  'border-radius: 20px',
  'letter-spacing: 0.5px'
].join(';');

header.appendChild(icon);
header.appendChild(title);
header.appendChild(badge);
block.appendChild(header);

// Divider
const divider = document.createElement('hr');
divider.style.cssText = 'border:none;border-top:1px solid #c5ddf5;margin:0 0 14px 0;';
