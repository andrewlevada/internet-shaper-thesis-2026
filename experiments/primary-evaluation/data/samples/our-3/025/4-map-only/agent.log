                  "description": "Text to replace. Whitespace and newlines may differ from the snapshot; include enough surrounding HTML to make the match unique and non-overlapping with other edits in the same call."
                },
                "newText": {
                  "type": "string",
                  "description": "Replacement text for this targeted edit."
                }
              },
              "required": [
