function parseViewerCount(text) {
  if (!text) return NaN;
  text = text.replace(/[^0-9.]/g, '');
  var num = parseFloat(text);
  if (isNaN(num)) return NaN;
  if (text.includes('M')) num *= 1000000;
  else if (text.includes('K') || text.includes('k')) num *= 1000;
  return num;
}

function applySort() {
  var tower = document.querySelector('.ScTower-sc-1sjzzes-0');
  if (!tower) return;
  var sortValue = select.value;
  var items = Array.from(tower.querySelectorAll(':scope > .kpalQF'));
  if (items.length === 0) return;

  if (sortValue === 'default') {
    items.forEach(function(item) { item.style.order = ''; });
    return;
  }

  tower.style.display = 'flex';
  tower.style.flexWrap = 'wrap';
  tower.style.alignItems = 'flex-start';

  var viewersMap = [];
  items.forEach(function(item, idx) {
    var statEl = item.querySelector('.tw-media-card-stat');
    var viewerText = statEl ? statEl.textContent.trim() : '';
    var count = parseViewerCount(viewerText);
    viewersMap.push({ el: item, count: isNaN(count) ? Infinity : count, originalIdx: idx });
  });

  if (sortValue === 'lowest') {
    viewersMap.sort(function(a, b) { return a.count - b.count; });
  } else if (sortValue === 'highest') {
    viewersMap.sort(function(a, b) { return b.count - a.count; });
  }

  viewersMap.forEach(function(entry) {
    entry.el.style.order = entry.originalIdx;
  });

  if (sortValue === 'lowest') {
    viewersMap.forEach(function(entry, i) { entry.el.style.order = i; });
  } else if (sortValue === 'highest') {
    viewersMap.forEach(function(entry, i) { entry.el.style.order = i; });
  }
}

select.addEventListener('change', applySort);

