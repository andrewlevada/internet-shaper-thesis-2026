<script>
(function() {
  function parseViewerCount(str) {
    if (!str) return 0;
    str = str.replace(/[^0-9.]/g, '');
    const num = parseFloat(str);
    if (isNaN(num)) return 0;
    if (str.includes('M')) return num * 1000000;
    if (str.includes('K')) return num * 1000;
    return num;
  }

  function getStreamCards() {
    const tower = document.querySelector('.tw-tower');
    if (!tower) return [];
    return Array.from(tower.querySelectorAll('.kpalQF')).filter(el => el.querySelector('.ghbJdj'));
  }

  function restoreOriginalOrder() {
    const tower = document.querySelector('.tw-tower');
    if (!tower) return;
    const cards = getStreamCards();
    const resizeDetectors = Array.from(tower.querySelectorAll('.resize-detector, .ScTowerPlaceholder-sc-1sjzzes-1'));
    cards.forEach((card, i) => {
      card.style.order = '';
    });
  }

  function sortStreams(direction) {
    const tower = document.querySelector('.tw-tower');
    if (!tower) return;

    // Make the tower a flex container for ordering
    tower.style.display = 'flex';
    tower.style.flexWrap = 'wrap';
    tower.style.alignContent = 'flex-start';

    const cards = getStreamCards();
    const viewers = cards.map(card => {
      const statEl = card.querySelector('.tw-media-card-stat');
      return parseViewerCount(statEl ? statEl.textContent : '0');
    });

    // Sort indices by viewer count
    const indices = viewers.map((v, i) => i);
    if (direction === 'lowest') {
      indices.sort((a, b) => viewers[a] - viewers[b]);
    } else if (direction === 'highest') {
      indices.sort((a, b) => viewers[b] - viewers[a]);
    }

    // Apply CSS order to cards
    cards.forEach(card => card.style.order = '999');
    indices.forEach((originalIdx, sortedPos) => {
      cards[originalIdx].style.order = sortedPos;
    });

    // Update status
    const statusEl = document.getElementById('cozy-sort-status');
    if (statusEl) {
      const smallest = Math.min(...viewers);
      const largest = Math.max(...viewers);
      statusEl.textContent = `${cards.length} streams · ${smallest.toLocaleString()}–${largest.toLocaleString()} viewers`;
    }
  }

  // Store original HTML for restore
  const towerEl = document.querySelector('.tw-tower');
  let originalTowerHTML = null;

  function saveOriginalOrder() {
    if (!originalTowerHTML && towerEl) {
      originalTowerHTML = towerEl.innerHTML;
    }
  }

  // Listen for select changes
  const select = document.getElementById('cozy-sort-select');
  if (select) {
    select.addEventListener('change', function() {
      saveOriginalOrder();
      if (this.value === 'default') {
        if (originalTowerHTML && towerEl) {
          towerEl.style.display = '';
          towerEl.innerHTML = originalTowerHTML;
          originalTowerHTML = null;
        }
        const statusEl = document.getElementById('cozy-sort-status');
        if (statusEl) statusEl.textContent = 'Showing trending streams';
      } else {
        sortStreams(this.value);
      }
    });
  }

  // Auto-save original on load
  saveOriginalOrder();
})();
</script>


