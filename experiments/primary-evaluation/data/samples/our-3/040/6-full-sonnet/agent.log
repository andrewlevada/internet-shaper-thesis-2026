    const rawText = (descEl.innerText || descEl.textContent || '').replace(/Sponsored/gi, '').trim();
    desc.textContent = rawText;
    desc.style.cssText = [
      'font-size: 12px',
      'color: #444',
      'margin: 0',
      'line-height: 1.5',
      'display: -webkit-box',
      '-webkit-line-clamp: 3',
      '-webkit-box-orient: vertical',
      'overflow: hidden'
    ].join(';');
    card.appendChild(desc);
  }

  // Callout badges
  const calloutEl = ad.querySelector('.callout_vis');
  if (calloutEl) {
    const calloutText = (calloutEl.textContent || '').trim();
    if (calloutText) {
      const calloutRow = document.createElement('div');
      calloutRow.style.cssText = 'display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px;';
      calloutText.split('·').forEach(function(chunk) {
        const chunkTrim = chunk.trim();
        if (!chunkTrim) return;
        const tag = document.createElement('span');
        tag.textContent = chunkTrim;
        tag.style.cssText = [
          'background: #e8f5e9',
          'color: #2e7d32',
          'font-size: 10px',
          'font-weight: 600',
          'padding: 2px 7px',
          'border-radius: 8px',
          'border: 1px solid #a5d6a7'
        ].join(';');
        calloutRow.appendChild(tag);
      });
      card.appendChild(calloutRow);
    }
  }

  // URL cite
  const citeEl = ad.querySelector('cite');
  if (citeEl) {
    const citeDiv = document.createElement('div');
    citeDiv.textContent = (citeEl.textContent || '').trim();
    citeDiv.style.cssText = 'font-size: 10.5px; color: #006621; margin-top: 4px; word-break: break-all;';
    card.appendChild(citeDiv);
  }

  // "Shop Now" CTA button
  const anchor = ad.querySelector('h2 a');
  if (anchor) {
    const cta = document.createElement('a');
    cta.href = anchor.href || '#';
    cta.target = '_blank';
    cta.rel = 'noopener noreferrer';
    cta.textContent = '🛍️ Shop Now';
    cta.style.cssText = [
      'display: inline-block',
      'margin-top: auto',
      'padding: 7px 14px',
      'background: linear-gradient(135deg, #f39c12, #e67e22)',
      'color: #fff',
      'font-size: 12px',
      'font-weight: 700',
      'border-radius: 20px',
      'text-decoration: none',
      'text-align: center',
      'letter-spacing: 0.3px',
      'box-shadow: 0 2px 6px rgba(230,126,34,0.35)',
      'transition: opacity 0.15s'
    ].join(';');
    cta.onmouseover = function() { this.style.opacity = '0.85'; };
    cta.onmouseout  = function() { this.style.opacity = '1'; };
    card.appendChild(cta);
  }

  track.appendChild(card);
});

trackWrapper.appendChild(track);

// ── Scroll arrow buttons ──────────────────────────────────────────────────────
function makeArrow(dir) {
  const btn = document.createElement('button');
  btn.textContent = dir === 'left' ? '‹' : '›';
  btn.style.cssText = [
    'position: absolute',
    'top: 50%',
    'transform: translateY(-50%)',
    dir === 'left' ? 'left: -16px' : 'right: -16px',
    'z-index: 5',
    'width: 32px',
    'height: 32px',
    'border-radius: 50%',
    'border: 2px solid #f39c12',
    'background: #fff',
    'color: #f39c12',
    'font-size: 22px',
    'line-height: 1',
    'cursor: pointer',
    'box-shadow: 0 2px 8px rgba(0,0,0,0.15)',
    'display: flex',
    'align-items: center',
    'justify-content: center',
    'padding: 0',
    'font-weight: 700'
  ].join(';');
  btn.onclick = function() {
    const t = document.getElementById('__spc_track__');
    if (t) t.scrollLeft += dir === 'left' ? -300 : 300;
  };
  return btn;
}

trackWrapper.appendChild(makeArrow('left'));
trackWrapper.appendChild(makeArrow('right'));
carousel.appendChild(trackWrapper);

// ── Footer note ───────────────────────────────────────────────────────────────
const footer = document.createElement('div');
footer.textContent = '✦ Deals sourced from sponsored listings on this page';
footer.style.cssText = 'font-size: 10.5px; color: #a07820; margin-top: 10px; text-align: right;';
carousel.appendChild(footer);

// ── Insert at very top of results list ───────────────────────────────────────
element.insertBefore(carousel, element.firstChild);


