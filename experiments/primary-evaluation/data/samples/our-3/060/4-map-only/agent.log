      "newText": "<div class=\"Layout-sc-1xcs6mc-0 ibRGZe\" style=\"max-width: 200rem; gap: 5px;\"><h1 class=\"CoreText-sc-1txzju1-0 ScTitleText-sc-d9mj2s-0 gfKkXK lbYztg tw-title\">Just Chatting &amp; IRL</h1><p class=\"CoreText-sc-1txzju1-0 cWFBTs\">Whether it's talking, traveling, or touching grass, these Just Chatting &amp; IRL streams have something for everyone.</p></div>\n\n<!-- Language Filter Selector -->\n<div id=\"twitch-lang-filter-bar\" style=\"max-width:200rem;margin:0 auto 16px;padding:12px 16px;background:var(--color-background-main-secondary,#18181b);border-radius:6px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;\">\n  <label for=\"twitch-lang-filter\" style=\"font-weight:700;font-size:14px;color:var(--color-text,#efeff1);white-space:nowrap;\">🌐 Filter by Language:</label>\n  <select id=\"twitch-lang-filter\" style=\"padding:8px 12px;border-radius:4px;border:1px solid var(--color-button-focus-border,#3a3a3d);background:var(--color-background-alt-secondary,#1f1f23);color:var(--color-text,#efeff1);font-size:14px;cursor:pointer;min-width:180px;\"></select>\n  <span id=\"twitch-lang-filter-count\" style=\"font-size:13px;color:var(--color-text-secondary,#adadb8);\"></span>\n</div>\n\n<script>\n(function() {\n  const filterBar = document.getElementById('twitch-lang-filter-bar');\n  const selectEl = document.getElementById('twitch-lang-filter');\n  const countEl = document.getElementById('twitch-lang-filter-count');\n\n  // Known language tag names used by Twitch\n  const knownLanguageTags = [\n    'English','Spanish','Portuguese','French','German','Italian','Japanese','Korean',\n    'Chinese','Russian','Turkish','Polish','Arabic','Dutch','Romanian','Swedish',\n    'Norwegian','Danish','Finnish','Greek','Czech','Hungarian','Thai','Vietnamese',\n    'Indonesian','Hindi','Tagalog','Ukrainian','Hebrew','Bengali','Filipino'\n  ];\n\n  function getLanguageForCard(card) {\n    // The first tag in the fsLBGq .cYTUJE container is typically the language tag.\n    // We check if its data-a-target matches a known language.\n    const tagContainer = card.querySelector('.fsLBGq .cYTUJE');\n    if (!tagContainer) return null;\n    const firstTag = tagContainer.querySelector('.jLHva-d > a.tw-tag');\n    if (!firstTag) return null;\n    const target = firstTag.getAttribute('data-a-target');\n    if (target && knownLanguageTags.includes(target)) {\n      return target;\n    }\n    // Fallback: check aria-label\n    const ariaLabel = firstTag.getAttribute('aria-label') || '';\n    for (const lang of knownLanguageTags) {\n      if (ariaLabel.toLowerCase().includes(lang.toLowerCase())) {\n        return lang;\n      }\n    }\n    return null;\n  }\n\n  function collectLanguages() {\n    const cards = document.querySelectorAll('.tw-tower .kpalQF article.ghbJdj');\n    const langs = new Set();\n    cards.forEach(card => {\n      const lang = getLanguageForCard(card);\n      if (lang) langs.add(lang);\n    });\n    return Array.from(langs).sort();\n  }\n\n  function populateSelect() {\n    const languages = collectLanguages();\n    selectEl.innerHTML = '';\n\n    // \"All\" option\n    const allOpt = document.createElement('option');\n    allOpt.value = '__all__';\n    allOpt.textContent = 'All Languages';\n    selectEl.appendChild(allOpt);\n\n    languages.forEach(lang => {\n      const opt = document.createElement('option');\n      opt.value = lang;\n      opt.textContent = lang;\n      selectEl.appendChild(opt);\n    });\n  }\n\n  function applyFilter() {\n    const selectedLang = selectEl.value;\n    const cards = document.querySelectorAll('.tw-tower .kpalQF article.ghbJdj');\n    let visibleCount = 0;\n\n    cards.forEach(card => {\n      const cardLang = getLanguageForCard(card);\n      if (selectedLang === '__all__' || cardLang === selectedLang) {\n        card.style.display = '';\n        // Also show the parent kpalQF wrapper\n        const wrapper = card.closest('.kpalQF');\n        if (wrapper) wrapper.style.display =