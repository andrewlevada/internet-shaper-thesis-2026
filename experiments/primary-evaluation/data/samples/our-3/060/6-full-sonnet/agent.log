if (document.getElementById('lang-filter-bar')) return;

// --- Collect all language tags already on the page ---
function getLanguagesFromPage() {
  const langs = new Set();
  document.querySelectorAll('a.tw-tag[aria-label]').forEach(tag => {
    const label = tag.getAttribute('aria-label') || '';
    const match = label.match(/^Tag,\s*(.+)$/);
    if (match) {
      const candidate = match[1].trim();
      // Heuristic: treat as a language tag only if it looks like a real language word
      // (starts with uppercase, no spaces or minimal spaces, not too long)
      if (/^[A-ZÀ-Ö][a-zA-ZÀ-öø-ÿ\u00C0-\u024F\u4E00-\u9FFF]{1,24}$/.test(candidate) && candidate.length <= 25) {
        langs.add(candidate);
      }
    }
  });
  return Array.from(langs).sort();
}

