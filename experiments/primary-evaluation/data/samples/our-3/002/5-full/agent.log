  cardFooter.appendChild(readMore);
  
  cardLink.appendChild(imgContainer);
  cardLink.appendChild(titleArea);
  cardLink.appendChild(cardFooter);
  
  grid.appendChild(cardLink);
});

content.appendChild(grid);
card.appendChild(header);
card.appendChild(content);
gridModule.appendChild(card);

// Insert into main content after the Top Stories module
const mainContent = document.querySelector('.region-main');
if (mainContent) {
  const topStories = mainContent.querySelector('[aria-label="TOP STORY"]');
  if (topStories) {
    mainContent.insertBefore(gridModule, topStories.nextSibling);
  } else {
    mainContent.insertBefore(gridModule, mainContent.children[1]);
  }
}

