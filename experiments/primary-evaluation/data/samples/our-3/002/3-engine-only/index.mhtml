@charset "utf-8";

:root { --line-clamp: 2; --score-align: flex-end; --stars-align: flex-end; =
--country-align: flex-start; --padding-bottom: 8px; --title-height: auto; }

.grp--price .grp--inner { display: flex; flex-direction: column; align-item=
s: center; justify-content: center; }

.lyr--weather_degrees { margin-top: -10%; }

.grp--score { display: flex; flex-direction: row; align-items: center; just=
ify-content: var(--score-align); gap: 5px; }

.grp--score .grp--sticker { position: relative; display: flex; flex-directi=
on: column; align-items: center; justify-content: center; }

.grp--acco_stars { display: flex; flex-direction: row; align-items: center;=
 justify-content: var(--stars-align); }

.grp--acco_stars .lyr { position: relative; left: auto !important; top: aut=
o !important; }

.grp--country { display: flex; flex-direction: row; align-items: center; ju=
stify-content: var(--country-align); gap: 5px; }

.grp--country .lyr--product_country_value { min-width: 0px; white-space: no=
wrap; text-overflow: ellipsis; overflow: clip visible; }

.grp--country .lyr--product_country_value .linebreak { display: inline !imp=
ortant; }

.lyr--product_title_accommodation { display: -webkit-box; -webkit-line-clam=
p: var(--line-clamp); -webkit-box-orient: vertical; overflow: hidden; paddi=
ng-bottom: 10px; position: relative; -webkit-text-stroke: 0.6px currentcolo=
r; paint-order: stroke; height: auto !important; }

.lyr--product_title_accommodation .linebreak { display: inline !important; =
}

.lyr--product_title { height: var(--title-height) !important; }

.overflow_spacer { position: absolute; bottom: 0px; left: 0px; right: 0px; =
height: var(--padding-bottom); background: rgb(255, 255, 255); }

.lyr--product_country_icon { border: 1px solid rgb(204, 204, 204); flex-shr=
ink: 0; }
