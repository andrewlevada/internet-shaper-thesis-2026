  border-radius: 3px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

#persistent-filter-sidebar .filter-option.active .filter-checkbox {
  background: #3ea6ff;
  border-color: #3ea6ff;
}

#persistent-filter-sidebar .filter-option.active .filter-checkbox::after {
  content: '';
  display: block;
  width: 5px;
  height: 9px;
  border: solid #0f0f0f;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg) translate(-1px, -1px);
}

