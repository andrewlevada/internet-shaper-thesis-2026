  border-bottom: none;
}

#persistent-filter-sidebar .filter-section-title {
  font-size: 14px;
  font-weight: 600;
  color: #f1f1f1;
  margin-bottom: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

#persistent-filter-sidebar .filter-section-title svg {
  width: 18px;
  height: 18px;
  fill: #aaa;
}

#persistent-filter-sidebar .filter-option {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 8px;
  border-radius: 8px;
  cursor: pointer;
  color: #f1f1f1;
  font-size: 13px;
  transition: background 0.15s ease;
  user-select: none;
}

#persistent-filter-sidebar .filter-option:hover {
  background: #272727;
}

#persistent-filter-sidebar .filter-option.active {
  color: #3ea6ff;
}

#persistent-filter-sidebar .filter-checkbox {
