;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n#persistent-filter-sidebar .filter-section-title svg {\n  width: 18px;\n  height: 18px;\n  fill: #aaa;\n}\n\n#persistent-filter-sidebar .filter-option {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 8px;\n  border-radius: 8px;\n  cursor: pointer;\n  color: #f1f1f1;\n  font-size: 13px;\n  transition: background 0.15s ease;\n  user-select: none;\n}\n\n#persistent-filter-sidebar .filter-option:hover {\n  background: #272727;\n}\n\n#persistent-filter-sidebar .filter-option.active {\n  color: #3ea6ff;\n}\n\n#persistent-filter-sidebar .filter-checkbox {\n  width: 18px;\n  height: 18px;\n  border: 2px solid #717171;\n  border-radius: 3px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  transition: all 0.15s ease;\n}\n\n#persistent-filter-sidebar .filter-option.active .filter-checkbox {\n  background: #3ea6ff;\n  border-color: #3ea6ff;\n}\n\n#persistent-filter-sidebar .filter-option.active .filter-checkbox::after {\n  content: '';\n  display: block;\n  width: 5px;\n  height: 9px;\n  border: solid #0f0f0f;\n  border-width: 0 2px 2px 0;\n  transform: rotate(45deg) translate(-1px, -1px);\n}\n\n#persistent-filter-sidebar .filter-chips-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  padding: 4px 0;\n}\n\n#persistent-filter-sidebar .filter-chip {\n  padding: 5px 12px;\n  border-radius: 16px;\n  background: #272727;\n  color: #f1f1f1;\n  font-size: 12px;\n  cursor: pointer;\n  transition: all 0.15s ease;\n  border: 1px solid transparent;\n  white-space: nowrap;\n}\n\n#persistent-filter-sidebar .filter-chip:hover {\n  background: #3a3a3a;\n}\n\n#persistent-filter-sidebar .filter-chip.active {\n  background: rgba(62, 166, 255, 0.15);\n  color: #3ea6ff;\n  border-color: rgba(62, 166, 255, 0.4);\n}\n\n#persistent-filter-sidebar .filter-range-group {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  margin-top: 8px;\n}\n\n#persistent-f