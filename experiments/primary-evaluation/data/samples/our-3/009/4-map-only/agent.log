}

/* Persistent Filter Sidebar */
#persistent-filter-sidebar {
  position: fixed;
  top: 56px;
  left: 0;
  width: 240px;
  height: calc(100vh - 56px);
  background: #0f0f0f;
  border-right: 1px solid #303030;
  overflow-y: auto;
  z-index: 200;
  padding: 12px 0;
  font-family: 'Roboto', Arial, sans-serif;
}

#persistent-filter-sidebar .filter-section {
  padding: 8px 16px;
  border-bottom: 1px solid #303030;
}

