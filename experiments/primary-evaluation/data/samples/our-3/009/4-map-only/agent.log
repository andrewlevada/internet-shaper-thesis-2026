<script>
// Hide the original filter button inside shadow DOM
document.querySelectorAll('ytd-search-header-renderer').forEach(function(renderer) {
  var root = renderer.shadowRoot;
  if (root) {
    var filterBtn = root.querySelector('#filter-button');
    if (filterBtn) {
      filterBtn.style.display = 'none';
    }
  }
});

// Also hide via CSS-injected approach for shadow DOM
document.querySelectorAll('ytd-search').forEach(function(search) {
  var root = search.shadowRoot;
  if (root) {
    var existingStyle = root.querySelector('#persistent-filter-styles');
    if (!existingStyle) {
      var s = document.createElement('style');
      s.id = 'persistent-filter-styles';
      s.textContent = '#filter-button { display: none !important; }';
      root.appendChild(s);
    }
  }
});

// Inject advanced filter chips into ytd-search shadow DOM
(function() {
  var searchEl = document.querySelector('ytd-search');
  if (!searchEl) return;
  var root = searchEl.shadowRoot;
  if (!root) return;

  // Add styles for advanced chips
  var chipStyle = document.createElement('style');
  chipStyle.id = 'advanced-chip-styles';
  chipStyle.textContent = '
    #advanced-filter-chips-bar {
      display: flex;
      gap: 8px;
      padding: 4px 24px 12px 24px;
      flex-wrap: wrap;
      align-items: center;
    }
    .adv-chip {
      padding: 6px 14px;
      border-radius: 8px;
      background: #272727;
      color: #f1f1f1;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.15s ease;
      border: 1px solid transparent;
      white-space: nowrap;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-family: Roboto, Arial, sans-serif;
      user-select: none;
    }
    .adv-chip:hover {
      background: #3a3a3a;
    }
    .adv-chip.active {
      background: rgba(62, 166, 255, 0.15);
      color: #3ea6ff;
      border-color: rgba(62, 166, 255, 0.4);
    }
    .adv-chip svg {
      width: 14px;
      height: 14px;
      fill: currentColor;
    }
    .adv-chip-separator {
      width: 1px;
      height: 20px;
      background: #555;
      margin: 0 4px;
    }
  ';
  root.appendChild(chipStyle);

  // Create chips container
  var chipsBar = document.createElement('div');
  chipsBar.id = 'advanced-filter-chips-bar';

  var chips = [
    { label: '🎬 Shorts', icon: '' },
    { label: '⭐ 4K', icon: '' },
    { label: '📺 Live', icon: '' },
    { label: '🎵 Music', icon: '' },
    { label: '🎮 Gaming', icon: '' },
    { label: '📰 News', icon: '' },
    { label: '🏋️ Fitness', icon: '' },
    { label: '🍳 Cooking', icon: '' },
    { label: '💻 Tech', icon: '' },
    { label: '🎓 Education', icon: '' },
    { label: '😂 Comedy', icon: '' },
    { label: '🐾 Animals', icon: '' },
    { label: '✈️ Travel', icon: '' },
    { label: '💰 Finance', icon: '' },
    { label: '🎨 Art', icon: '' },
    { label: '🔬 Science', icon: '' },
    { label: '⚽ Sports', icon: '' },
    { label: '🎭 Film', icon: '' },
  ];

  chips.forEach(function(chip) {
    var chipEl = document.createElement('div');
    chipEl.className = 'adv-chip';
    chipEl.textContent = chip.label;
    chipEl.onclick = function() { this.classList.toggle('active'); };
    chipsBar.appendChild(chipEl);
  });

  // Insert after header
  var container = root.querySelector('#container');
  if (container) {
    var header = container.querySelector('#header');
    if (header && header.nextSibling) {
      container.insertBefore(chipsBar, header.nextSibling);
    } else if (header) {
      container.appendChild(chipsBar);
    }
  }
})();
</script>


