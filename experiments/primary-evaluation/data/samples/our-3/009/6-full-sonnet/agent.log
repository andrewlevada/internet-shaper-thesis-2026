const panel = document.createElement('div');
panel.id = 'yt-ext-filter-panel';

const titleDiv = document.createElement('div');
titleDiv.className = 'yt-ext-fp-title';
titleDiv.appendChild(makeIcon('M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z'));
titleDiv.appendChild(document.createTextNode('\u00A0Search Filters'));
panel.appendChild(titleDiv);

sections.forEach(function(sec) { panel.appendChild(makeSection(sec.header, sec.chips)); });

element.insertBefore(panel, element.firstChild);

// Mark active chip from URL
try {
  var urlParams = new URLSearchParams(document.location.search);
  var currentSp = urlParams.get('sp');
  if (currentSp) {
    panel.querySelectorAll('.yt-ext-fp-chip').forEach(function(chip) {
      if (chip.dataset.param === currentSp) chip.classList.add('active');
    });
  }
} catch(e) {}

panel.addEventListener('click', function(e) {
  var chip = e.target.closest('.yt-ext-fp-chip');
  if (!chip) return;
  var param = chip.dataset.param;
  try {
    var url = new URL(document.location.href);
    if (chip.classList.contains('active')) {
      chip.classList.remove('active');
      url.searchParams.delete('sp');
    } else {
      chip.closest('.yt-ext-fp-section').querySelectorAll('.yt-ext-fp-chip').forEach(function(c){ c.classList.remove('active'); });
      chip.classList.add('active');
      url.searchParams.set('sp', param);
    }
    document.location.href = url.toString();
  } catch(e) {}
});


