.productModule [class*="discount"],
.productModule [class*="savings"],
.productModule [data-testid*="save"],
.productModule [data-testid*="discount"] {
  font-size: 1.75rem !important;
  font-weight: 800 !important;
  color: #16a34a !important;
  background-color: #dcfce7 !important;
  padding: 4px 10px !important;
  border-radius: 6px !important;
  display: inline-block !important;
}
/* Also target any text node containing "Save" pattern via attribute selectors */
.productModule [aria-label*="Save"],
.productModule [title*="Save"] {
  font-size: 1.75rem !important;
  font-weight: 800 !important;
  color: #16a34a !important;
  background-color: #dcfce7 !important;
  padding: 4px 10px !important;
  border-radius: 6px !important;
}
/* Target the flex container's children that show savings */
.productModule .flex.flex-wrap.items-center > div:not(:first-child),
.productModule .flex.flex-wrap.items-center > span:not(:first-child) {
  font-size: 1.75rem !important;
  font-weight: 800 !important;
  color: #16a34a !important;
}
</style>


