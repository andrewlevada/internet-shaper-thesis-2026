@charset "utf-8";

.VoiceInput { position: relative; padding: 4px; border-radius: 50%; transit=
ion: 0.1s ease-out; }

.utilityfocus .VoiceInput:focus { outline: rgb(248, 96, 74) solid 2px; }

.VoiceInput .Button-Text { display: flex; justify-content: center; align-it=
ems: center; width: 32px; height: 32px; }

.VoiceInput_redesign { color: var(--depot-color-fill-40); }

.VoiceInput-Ripple { position: absolute; z-index: 1; width: 40px; height: 4=
0px; content: ""; border-radius: 50%; transition: transform var(--local-tra=
nsition, .7s) ease-in-out; will-change: transform; }

.VoiceInput-Ripple:first-child { opacity: 0.2; transform: scale(calc(1.1 + =
var(--local-ripple-scale, 0))); }

.VoiceInput-Ripple:nth-child(2) { opacity: 0.1; transform: scale(calc(1.2 +=
 var(--local-ripple-scale, 0)*2)); }

.VoiceInput_active .VoiceInput-Ripple { background-color: rgb(248, 96, 74);=
 }

.i-ua_skin_dark .VoiceInput-Ripple:first-child { opacity: 0.4; }

.i-ua_skin_dark .VoiceInput-Ripple:nth-child(2) { opacity: 0.2; }

.VoiceInput_active { color: rgb(255, 255, 255); background-color: rgb(248, =
96, 74); }

.VoiceInput-Icon { z-index: 2; width: 32px; height: 32px; }

.VoiceInput-Icon rect { transition: height var(--local-transition, .7s) eas=
e-in-out; transform: rotate(180deg); transform-origin: center center; }

.Popup2-Tail { width: 24px; height: 24px; pointer-events: none; }

.Popup2-TailSvg { display: block; }

.Popup2[data-popper-placement^=3D"top"] .Popup2-Tail { top: 100%; transform=
: rotate(180deg); }

.Popup2[data-popper-placement^=3D"left"] .Popup2-Tail { left: 100%; transfo=
rm: rotate(90deg); }

.Popup2[data-popper-placement^=3D"bottom"] .Popup2-Tail { bottom: 100%; }

.Popup2[data-popper-placement^=3D"right"] .Popup2-Tail { right: 100%; trans=
form: rotate(-90deg); }

.Popup2 { --local-color-popup-blue-bg: #035ad1; --local-color-popup-blue-te=
xt: #eceff1; --local-color-popup-dark-shadow: 0 6px 10px rgba(0, 0, 0, .3);=
 --local-color-popup-beauty-shadow: 0 10px 20px -5px rgba(0, 0, 0, .3), 0 0=
 0 1px rgba(0, 0, 0, .05); --local-color-popup-tooltip-shadow: 0 6px 20px -=
4px rgba(0, 0, 0, .7); position: absolute; z-index: 1400; }

.Popup2[data-popper-reference-hidden], .Popup2[data-popper-escaped] { visib=
ility: hidden !important; margin: -9999px 0px 0px -9999px !important; point=
er-events: none !important; }

.SnackbarTransitioned { bottom: 16px; left: 50%; display: flex; align-items=
: center; width: calc(100% - 32px); opacity: 0; color: rgb(255, 255, 255); =
transform: translate(-50%, 80px); }

.SnackbarTransitioned.Popup2 { position: fixed; }

[class].SnackbarTransitioned-enter-active { transition: opacity 150ms, tran=
sform 150ms; }

.SnackbarTransitioned-enter-active { opacity: 1; transform: translate(-50%,=
 0px); }

.SnackbarTransitioned-enter-done { opacity: 1; transform: translate(-50%, 0=
px); }

.SnackbarTransitioned-exit { opacity: 1; transform: translate(-50%, 0px); }

[class].SnackbarTransitioned-exit-active { transition: opacity 150ms, trans=
form 150ms; }

.SnackbarTransitioned-exit-active { opacity: 0; transform: translate(-50%, =
80px); }

.SnackbarTransitioned-exit-done { opacity: 0; }

.SnackbarTransitioned-Content { display: flex; justify-content: flex-start;=
 align-items: center; width: 100%; min-height: 36px; padding: 12px; border-=
radius: 16px; outline: 0px; background: rgb(47, 47, 50); box-shadow: rgba(0=
, 0, 0, 0.4) 0px 10px 20px -5px; }

.Popup2_view_default { visibility: hidden; box-sizing: border-box; margin: =
-9999px 0px 0px -9999px; color: var(--depot-color-text-primary); border-rad=
ius: 10px; background-color: var(--depot-color-popup-fill-base); box-shadow=
: rgba(0, 0, 0, 0.3) 0px 11px 14px -7px; animation-duration: 0.1s; animatio=
n-timing-function: ease-out; animation-fill-mode: forwards; }

.Popup2_view_default::before { position: absolute; inset: 0px; content: "";=
 border-radius: inherit; box-shadow: rgba(0, 0, 0, 0.05) 0px 0px 0px 1px; }

