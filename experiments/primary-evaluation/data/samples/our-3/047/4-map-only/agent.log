<script>
(function() {
  // Wait for DOM to be ready
  function prioritizeHardNews() {
    const feedList = document.querySelector('#strm ul:first-of-type');
    if (!feedList) return;
    
    const allItems = Array.from(feedList.children);
    const hardNewsItems = [];
    const otherItems = [];
    const adItems = [];
    
    allItems.forEach(item => {
      // Check if it's a Taboola ad or other ad placeholder
      if (item.id && item.id.startsWith('taboola-')) {
        adItems.push(item);
        return;
      }
      if (item.classList.contains('md:hidden') || item.querySelector('#mid-center-ad-1')) {
        adItems.push(item);
        return;
      }
      
      // Check for article category
      const ygaData = item.querySelector('a[data-yga]');
      let category = '';
      if (ygaData) {
        try {
          const data = JSON.parse(ygaData.getAttribute('data-yga'));
          category = data.yContentCategory || '';
        } catch(e) {}
      }
      
      // Also check the visible category label
      const labelEl = item.querySelector('.label-m-emphasized');
      let labelText = labelEl ? labelEl.textContent.trim() : '';
      
      // Check data-ylk for category hints
      const ylkData = item.querySelector('a[data-ylk]');
      let ylkText = ylkData ? ylkData.getAttribute('data-ylk') || '' : '';
      
      const isHardNews = 
        category === 'Politics' || category === 'World' || category === 'U.S.' ||
        labelText === 'Politics' || labelText === 'World' || labelText === 'News' ||
        ylkText.includes('cnt_tpc:World') || ylkText.includes('cnt_tpc:U.S.') ||
        ylkText.includes('badge-politics') || ylkText.includes('badge-world') ||
        ylkText.includes('subsec:article-river') && (category === 'Politics' || category === 'World');
      
      if (isHardNews) {
        hardNewsItems.push(item);
      } else {
        otherItems.push(item);
      }
    });
    
    // Rebuild the feed: hard news first, then ads, then other content
    while (feedList.firstChild) {
      feedList.removeChild(feedList.firstChild);
    }
    
    hardNewsItems.forEach(item => feedList.appendChild(item));
    adItems.forEach(item => feedList.appendChild(item));
    otherItems.forEach(item => feedList.appendChild(item));
  }
  
  // Run after a short delay to ensure content is loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', prioritizeHardNews);
  }
  setTimeout(prioritizeHardNews, 500);
})();
</script>


