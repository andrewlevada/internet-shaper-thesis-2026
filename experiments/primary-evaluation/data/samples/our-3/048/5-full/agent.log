    (function() {
  if (element.dataset._horoscopeMoved) return;
  element.dataset._horoscopeMoved = '1';

  var conbarContent = element.querySelector('#conbar-content');
  if (!conbarContent) return;

  // Find the horoscope card (2nd child in conbar-content)
  var children = Array.from(conbarContent.children);
  var horoscopeCard = null;
  for (var i = 0; i < children.length; i++) {
    if (children[i].querySelector('[data-tooltip-id="horoscope-dropdown"]')) {
      horoscopeCard = children[i];
      break;
    }
  }
  if (!horoscopeCard) return;

  // Clone the horoscope card
  var clone = horoscopeCard.cloneNode(true);
  clone.style.display = 'flex';

  // Create a container to place it right after the header
  var container = document.createElement('div');
  container.id = 'custom-top-section';
  container.className = 'mx-auto mt-3 md:max-w-[760px] md:px-6 lg:max-w-[1000px] lg:px-6 xl:max-w-[var(--xl-page-max-width)] xl:px-8';
  container.style.display = 'flex';
  container.style.flexDirection = 'column';
  container.style.gap = '1rem';

  // Horoscope wrapper
  var horoscopeWrapper = document.createElement('div');
  horoscopeWrapper.className = 'flex justify-center';
  horoscopeWrapper.appendChild(clone);
  container.appendChild(horoscopeWrapper);

  // Find and clone the shopping section from the main feed
  var shoppingLi = document.querySelector('#strm li:has(a[data-ylk*="subsec:shopping"])');
  if (!shoppingLi) {
    // Fallback: search by text content
    var allLis = document.querySelectorAll('#strm ul li');
    for (var j = 0; j < allLis.length; j++) {
      if (allLis[j].textContent.indexOf('From Our Shopping Experts') !== -1) {
        shoppingLi = allLis[j];
        break;
      }
    }
  }

  if (shoppingLi) {
    var shoppingClone = shoppingLi.cloneNode(true);
    shoppingClone.style.display = 'block';
    shoppingClone.style.width = '100%';
    shoppingClone.style.border = 'none';
    container.appendChild(shoppingClone);
  }

  // Insert after the convenience-bar's parent section
  var parent = element.parentElement;
  if (parent) {
    parent.parentNode.insertBefore(container, parent.nextSibling);
  }
})();
[2] Hide political/military articles in feed — #strm ul li.list-none
    (function() {
  // Check for visible "Politics" label
  var labels = element.querySelectorAll('.label-m-emphasized');
  for (var i = 0; i < labels.length; i++) {
    var text = labels[i].textContent.trim();
    if (text === 'Politics' || text.toLowerCase().indexOf('politics') !== -1) {
      element.style.display = 'none';
      return;
    }
  }

  // Check data-yga for Politics category
  var links = element.querySelectorAll('a[data-yga]');
  for (var j = 0; j < links.length; j++) {
    var yga = links[j].getAttribute('data-yga') || '';
    if (yga.indexOf('"yContentCategory":"Politics"') !== -1) {
      element.style.display = 'none';
      return;
    }
  }

  // Check for military-related content via headline text and category
  var headlineLinks = element.querySelectorAll('h3 a');
  for (var k = 0; k < headlineLinks.length; k++) {
    var yga2 = headlineLinks[k].getAttribute('data-yga') || '';
    var text2 = headlineLinks[k].textContent.toLowerCase();
    
    // Military keywords in the content category or headline
    if (yga2.indexOf('"yContentCategory":"World"') !== -1) {
      // Only hide World articles with military/conflict keywords
      var militaryKeywords = ['strike', 'military', 'attack', 'war', 'missile', 'bomb', 'troop', 'soldier', 'combat', 'weapon', 'iran', 'drone'];
      for (var m = 0; m < militaryKeywords.length; m++) {
        if (text2.indexOf(militaryKeywords[m]) !== -1) {
          element.style.display = 'none';
          return;
        }
      }
    }
    
    // Also hide U.S. category articles that are clearly political
    if (yga2.indexOf('"yContentCategory":"U.S."') !== -1) {
      var politicsKeywords = ['trump', 'biden', 'congress', 'senate', 'white house', 'supreme court', 'judge', 'democrat', 'republican', 'election', 'campaign', 'administration'];
      for (var n = 0; n < politicsKeywords.length; n++) {
        if (text2.indexOf(politicsKeywords[n]) !== -1) {
          element.style.display = 'none';
          return;
        }
      }
    }
  }
})();
