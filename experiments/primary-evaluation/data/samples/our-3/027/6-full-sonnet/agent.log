{
  "query_selector": "[data-test-id=\"pin\"]",
  "label": "Show pin title & description below card",
  "logic": "\n// --- gather data ---\nconst anchor = element.querySelector('a[href*=\"/pin/\"]');\nif (!anchor) return;\n\nconst description = anchor.getAttribute('aria-label') || '';\nconst href = anchor.getAttribute('href') || '';\n\n// Extract username from URL: /pin/<id>/ → look for user in referrer path\n// Pinterest pin URLs are /pin/<id>/ — no username in that URL.\n// Username may be in a profile link; try to find it in a sibling or parent board reference.\n// Fallback: parse from data attribute or show \"Pinterest\"\nconst pinId = (href.match(/\\/pin\\/(\\d+)/) || [])[1] || '';\n\n// Try to get the image alt text (may be more descriptive than aria-label)\nconst img = element.querySelector('img[alt]');\nconst altText = img ? img.getAttribute('alt') : '';\n\n// Prefer alt text if longer/different from aria-label\nconst displayText = (altText && altText.length > 0) ? altText : description;\n\n// --- find or create the info bar ---\nconst BAR_CLASS = 'ext-pin-info-bar';\nlet bar = element.querySelector('.' + BAR_CLASS);\nif (!bar) {\n  bar = document.createElement('div');\n  bar.className = BAR_CLASS;\n  bar.style.cssText = [\n    'display: block',\n    'width: 100%',\n    'box-sizing: border-box',\n    'padding: 8px 10px 10px 10px',\n    'background: #fff',\n    'border-top: 1px solid #e9e9e9',\n    'border-radius: 0 0 16px 16px',\n    'font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif',\n    'pointer-events: none',\n    'z-index: 1',\n    'position: relative',\n  ].join('; ');\n  element.appendChild(bar);\n}\n\n// --- title (first ~6 words of description capitalised as a heading) ---\nconst titleEl_CLASS = 'ext-pin-info-title';\nconst descEl_CLASS  = 'ext-pin-info-desc';\nconst metaEl_CLASS  = 'ext-pin-info-meta';\n\nlet titleEl = bar.querySelector('.' + titleEl_CLASS);\nif (!titleEl) {\n  titleEl = document.createElement('div');\n  titleEl.className = titleEl_CLASS;\n  titleEl.style.cssText = [\n    'font-size: 13px',\n    'font-weight: 700',\n    'color: #111',\n    'line-height: 1.4',\n    'margin-bottom: 3px',\n    'overflow: hidden',\n    'text-overflow: ellipsis',\n    'white-space: nowrap',\n    'max-width: 100%',\n  ].join('; ');\n  bar.appendChild(titleEl);\n}\n\nlet descEl = bar.querySelector('.' + descEl_CLASS);\nif (!descEl) {\n  descEl = document.createElement('div');\n  descEl.className = descEl_CLASS;\n  descEl.style.cssText = [\n    'font-size: 12px',\n    'font-weight: 400',\n    'color: #444',\n    'line-height: 1.4',\n    'display: -webkit-box',\n    '-webkit-line-clamp: 3',\n    '-webkit-box-orient: vertical',\n    'overflow: hidden',\n    'max-width: 100%',\n    'margin-bottom: 4px',\n  ].join('; ');\n  bar.appendChild(descEl);\n}\n\nlet metaEl = bar.querySelector('.' + metaEl_CLASS);\nif (!metaEl) {\n  metaEl = document.createElement('div');\n  metaEl.className = metaEl_CLASS;\n  metaEl.style.cssText = [\n    'font-size: 11px',\n    'font-weight: 500',\n    'color: #e60023',\n    'display: flex',\n    'align-items: center',\n    'gap: 4px',\n    'margin-top: 2px',\n  ].join('; ');\n  bar.appendChild(metaEl);\n}\n\n// --- populate title: capitalise first 8 words ---\nif (!displayText) return;\nconst words = displayText.split(' ');\nconst titleWords = words.slice(0, 8).join(' ');\nconst titleText = titleWords.charAt(0).toUpperCase() + titleWords.slice(1) + (words.length > 8 ? '…' : '');\ntitleEl.textContent = titleText;\n\n// --- populate description (full text) ---\ndescEl.textContent = displayText;\n\n// --- populate meta: pin ID as \"Pin #XXXX\" attribution ---\n// Try to find a user link in the page that matches this pin's surrounding card\nconst boardLink = element.closest('[data-grid-item=\"true\"]')\n  ? element.closest('[data-grid-item=\"true\"]').querySelector('a[href*=\"/pin/\"]')\n  : null;\n\n// Show pin ID as unique identifier\nmetaEl.innerHTML = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"#e60023\"><pa